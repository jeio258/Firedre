# 本地开发环境变量（复制为 .dev.vars，勿提交；cf-dev-shim 首次启动会自动生成 SESSION_SECRET）
# 会话签名密钥（必须配置，≥ 32 字符强随机；缺失时后台无法登录）
SESSION_SECRET=dev-session-secret-firedre-local-00000000
# 相册 WebDAV 源密码（仅使用 WebDAV 相册时需要）
WEBDAV_PASSWORD=your_webdav_password

# 前台用户会话签名密钥（不填则回退 SESSION_SECRET 体系；生产必须单独配置）
USER_SESSION_SECRET=dev-user-session-secret-firedre-0000000

# 邮件：MAIL_PROVIDER=smtp|brevo|none；缺省按已配置凭据推断（SMTP 优先）
# 生产必须显式 ENVIRONMENT=prod，否则只打印正文写 mail_log、不发信（日志里会以 [mail:dev skip] 标明）
ENVIRONMENT=dev
MAIL_PROVIDER=
# SMTP（worker-mailer，465 隐式 TLS / 587 STARTTLS）
# SMTP_PASS 填「授权码」而非登录密码：QQ/163 等需先在网页端设置里开启 SMTP 服务，
# 且服务商常按出口 IP 风控直接回 535，Worker 出口为境外机房时尤其容易命中
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
# Brevo HTTP API（作为 SMTP 的替代提供商；SMTP 被 535/风控时改这里，不受出口 IP 影响）
BREVO_API_KEY=
# 发件人，可写 "站点名 <no-reply@example.com>"；多数服务商要求与 SMTP_USER 同域或已做域名验证
MAIL_FROM=
# 1=注册响应回传 devVerifyUrl，便于本地不配置发信也能走完验证流程
MAIL_DEBUG=

# Cloudflare Turnstile（注册/登录人机校验）。本地回环且 ENVIRONMENT!=prod 时可留空
TURNSTILE_SECRET_KEY=

# OAuth 第三方登录（未配置则登录页隐藏对应入口）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
