---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import { live2dWidgetConfig, sidebarLayoutConfig, siteConfig } from "@/config";
import { getWallpaperConfig } from "@/config/runtime";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { isHomePage } from "@/utils/layout-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const settings =
	(
		Astro.locals as {
			settings?: import("../../server/settings/service").SettingsShape;
		}
	).settings ?? {};

const wallpaperConfig = getWallpaperConfig(Astro.locals);
const toImageArray = (v: unknown): string[] => {
	if (Array.isArray(v)) return (v as string[]).map(String).filter(Boolean);
	if (typeof v === "string" && v)
		return v.split(",").map((s) => s.trim()).filter(Boolean);
	return [];
};
const wallpaperSrc = (wallpaperConfig.src ?? {}) as {
	desktop?: unknown;
	mobile?: unknown;
};
const wallpaperDesktop = toImageArray(wallpaperSrc.desktop);
const wallpaperMobile = toImageArray(wallpaperSrc.mobile);
const backgroundImages = {
	desktop: wallpaperDesktop.length ? wallpaperDesktop : wallpaperMobile,
	mobile: wallpaperMobile.length ? wallpaperMobile : wallpaperDesktop,
	isMultiple: wallpaperDesktop.length > 1 || wallpaperMobile.length > 1,
};

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const categoryBarSetting = (settings as { categoryBar?: unknown }).categoryBar;
const shouldRenderCategoryBar =
	typeof categoryBarSetting === "boolean"
		? categoryBarSetting
		: !!((settings as any)?.["categoryBar"] ?? siteConfig.categoryBar);
const navbarWidthFull = ((settings as any)?.["navbar"] ?? siteConfig.navbar).widthFull ?? false;
const stickyNavbar = ((settings as any)?.["navbar"] ?? siteConfig.navbar).stickyNavbar ?? false;

const banner = getBannerVisibilityState(
	{
		isHomePage: isHomePageCheck,
		isPostPage,
		title,
		bannerPostMeta,
	},
	settings as unknown as Record<string, unknown> | undefined,
);
const sidebar = getEffectiveSidebarState({ isPostPage });

const { hasWallpaper } = banner;
const {
	hideSidebarOnPostPage,
	effectiveIsBothSidebars,
	effectiveHasLeftComponents,
	effectiveHasRightComponents,
	gridCols,
	sidebarClass,
	rightSidebarClass,
	staticBarClass,
	footerClassName,
	mobileShowSidebar,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} hasWallpaper={hasWallpaper}>

<slot slot="head" name="head" />
<HeaderTopRow stickyNavbar={stickyNavbar} navbarWidthFull={navbarWidthFull} />

<WallpaperSection state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<div class="content-panel absolute w-full z-30 pointer-events-none">

    <div class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-enable={sidebarLayoutConfig.enable ? "true" : "false"}
          data-grid-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                effectiveIsBothSidebars={effectiveIsBothSidebars}
                effectiveHasLeftComponents={effectiveHasLeftComponents}
                effectiveHasRightComponents={effectiveHasRightComponents}
                sidebarClass={sidebarClass}
                rightSidebarClass={rightSidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

            {                                           }
            <div class={staticBarClass}>
                {                     }
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {                              }
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {                                 }
                <h1 class="sr-only">{title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                effectiveIsBothSidebars={effectiveIsBothSidebars}
                effectiveHasLeftComponents={effectiveHasLeftComponents}
                effectiveHasRightComponents={effectiveHasRightComponents}
                sidebarClass={sidebarClass}
                rightSidebarClass={rightSidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

            {                          }
            {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4">
					<SideBar side="bottom" headings={headings} encrypted={encrypted}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {settings.pio?.enabled !== false && live2dWidgetConfig.enable && <Live2DWidget config={{ ...live2dWidgetConfig, ...(settings.pio ?? {}) }} />}
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

</Layout>
