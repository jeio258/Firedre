---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import {
	live2dWidgetConfig,
	resolveNavbarMode,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import { getWallpaperConfig } from "@/config/runtime";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const settings =
	(
		Astro.locals as {
			settings?: import("@server/settings/service").SettingsShape;
		}
	).settings ?? {};

const wallpaperConfig = getWallpaperConfig(Astro.locals);
const toImageArray = (v: unknown): string[] => {
	if (Array.isArray(v)) return (v as string[]).map(String).filter(Boolean);
	if (typeof v === "string" && v)
		return v
			.split(",")
			.map((s) => s.trim())
			.filter(Boolean);
	return [];
};
const wallpaperSrc = (wallpaperConfig.src ?? {}) as {
	desktop?: unknown;
	mobile?: unknown;
};
const wallpaperDesktop = toImageArray(wallpaperSrc.desktop);
const wallpaperMobile = toImageArray(wallpaperSrc.mobile);
const backgroundImages = {
	desktop: wallpaperDesktop.length ? wallpaperDesktop : wallpaperMobile,
	mobile: wallpaperMobile.length ? wallpaperMobile : wallpaperDesktop,
	isMultiple: wallpaperDesktop.length > 1 || wallpaperMobile.length > 1,
};

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	publishedTime,
	modifiedTime,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const categoryBarSetting = (settings as { categoryBar?: unknown }).categoryBar;
const shouldRenderCategoryBar =
	typeof categoryBarSetting === "boolean"
		? categoryBarSetting
		: !!((settings as any)?.["categoryBar"] ?? siteConfig.categoryBar);
const navbarWidthFull =
	((settings as any)?.["navbar"] ?? siteConfig.navbar).widthFull ?? false;
const navbarMode = resolveNavbarMode(
	(settings as any)?.["navbar"] ?? siteConfig.navbar,
);

const banner = getBannerVisibilityState(
	{
		isHomePage: isHomePageCheck,
		isPostPage,
		title,
		bannerPostMeta,
	},
	settings as unknown as Record<string, unknown> | undefined,
);
const sidebar = getEffectiveSidebarState({ isPostPage });

const { hasWallpaper } = banner;
// 壁纸 preload URL：仅外部 http 图片（本地图片走 _image 按需优化，URL 不可预测，不预取）
const wallpaperPreloadUrl =
	hasWallpaper && backgroundImages.desktop[0]?.startsWith("http")
		? backgroundImages.desktop[0]
		: null;
const {
	hideSidebarOnPostPage,
	hasLeftComponents,
	hasRightComponents,
	sidebarClass,
	staticBarClass,
	gridColumnStyle,
	gridDataAttrs,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} publishedTime={publishedTime} modifiedTime={modifiedTime} hasWallpaper={hasWallpaper} wallpaperPreloadUrl={wallpaperPreloadUrl}>

<slot slot="head" name="head" />
<HeaderTopRow navbarMode={navbarMode} navbarWidthFull={navbarWidthFull} />

<!-- 移动端导航抽屉：渲染为 <body> 直系子元素，脱离导航栏的 transform 包含块才能铺满视口 -->
<NavMenuPanel links={await resolveNavMenuLinks(Astro.locals)} />

<WallpaperSection state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<div id="content-panel" class="content-panel absolute w-full z-30 pointer-events-none">

    <div id="content-panel-inner" class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto" style={gridColumnStyle}>
        {/* 列几何唯一真源 = computeGridColumns()，SSR 写在父级 #content-panel-inner 上
            （页脚作为兄弟节点也要拿到 --content-ratio-*）。子元素无需定位类：
            侧栏包裹层是 display:contents，真正的 grid item 是内层元素 */}
        <div id="main-grid"
          class="transition duration-700 w-full left-0 right-0 grid mx-auto gap-4 px-2 md:px-4 mobile-no-sidebar"
          {...gridDataAttrs}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

            {/* 主内容区包装器 - 包含分类栏、swup 容器与移动端底部组件，作为单个 grid item */}
            <div id="content-column" class={staticBarClass}>
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                    <h1 class="sr-only">{title}</h1>
                    <div id="content-wrapper" class="onload-animation transition-leaving">
                        <slot></slot>
                    </div>
                </main>

                {/* 移动端底部组件：<768px 时 #main-grid 是 display:block，必须排在页脚之前 */}
                {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                    <div id="mobile-bottom-sidebar" class="block md:hidden mt-4">
                        <SideBar side="bottom" headings={headings} encrypted={encrypted}></SideBar>
                    </div>
                )}
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

        </div>

        <SpineModel></SpineModel>
        {settings.pio?.enabled !== false && live2dWidgetConfig.enable && <Live2DWidget config={{ ...live2dWidgetConfig, ...(settings.pio ?? {}) }} />}

        {/* 页脚宽度跨「侧栏 + 内容栏」，故在 #content-column 之外；又在 Swup 容器之外，
            切页不重渲染 */}
        <Footer />
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

</Layout>
