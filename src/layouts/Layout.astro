---
import GoogleAnalytics from "@components/analytics/GoogleAnalytics.astro";
import La51Analytics from "@components/analytics/La51Analytics.astro";
import MicrosoftClarity from "@components/analytics/MicrosoftClarity.astro";
import UmamiAnalytics from "@components/analytics/UmamiAnalytics.astro";
import CodeGroupManager from "@components/features/CodeGroupManager.astro";
import FancyboxManager from "@components/features/FancyboxManager.astro";
import FontSetup from "@components/features/FontSetup.astro";
import GithubCardManager from "@components/features/GithubCardManager.astro";
import MusicManager from "@components/features/MusicManager.astro";
import MusicPlayerView from "@components/features/MusicPlayerView.astro";
import SakuraEffect from "@components/features/SakuraEffect.astro";
import WavesEffect from "@components/features/WavesEffect.astro";
import ConfigCarrier from "@components/layout/ConfigCarrier.astro";
import FaviconLinks from "@components/layout/FaviconLinks.astro";
import SiteSeoMeta from "@components/layout/SiteSeoMeta.astro";
import { zh_CN } from "@i18n/languages/zh_CN";
import type { settingsDefaults } from "@shared/config/settings-defaults";
import {
	analyticsConfig,
	backgroundWallpaper,
	displaySettingsConfig,
	musicPlayerConfig,
	profileConfig,
	resolveNavbarMode,
	siteConfig,
} from "@/config";
import {
	getExpressiveCodeConfig,
	getNavbarConfig,
	getProfileConfig,
	getSiteConfig,
} from "@/config/runtime";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_NON_HOME,
	PAGE_WIDTH,
} from "@/constants/constants";
import { toClientSettings } from "@/utils/client-settings";
import { isHomePage } from "@/utils/layout-utils";
import {
	getAuthorAvatarUrl,
	getRawImageUrl,
	getSiteLogo,
} from "@/utils/schema-image";
import {
	buildSiteGraph,
	safeJsonLd,
	toAbsoluteUrl,
} from "@/utils/schema-utils";

import "@/styles/main.css";
import "@/styles/variables.styl";
import "@rehype-callouts-theme";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	hasWallpaper?: boolean;
	wallpaperPreloadUrl?: string | null;
	wallpaperPreloadUrlMobile?: string | null;
	allPostMeta?: Array<Record<string, unknown>>;
}

let {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	publishedTime,
	modifiedTime,
	hasWallpaper = false,
	wallpaperPreloadUrl,
	wallpaperPreloadUrlMobile,
	allPostMeta = [],
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);

// 当前构建语言的 i18n 词典（与 /i18n.js 端点内容一致；siteConfig.lang 决定，当前仅 zh_CN）
const currentI18n = zh_CN;

// 后台站点设置（覆盖静态 siteConfig 的关键项）：分组键 + 扁平键并存（见 server/settings/merge.ts）
// 分组字段取自 shared/config/settings-defaults.ts 真源；D1 可能存入的嵌套对象与静态同形分组在此显式声明
type LayoutSettings = import("@server/settings/service").SettingsShape & {
	basic?: Partial<(typeof settingsDefaults)["basic"]>;
	panel?: Partial<(typeof settingsDefaults)["panel"]>;
	profile?: Partial<(typeof settingsDefaults)["profile"]>;
	post?: Partial<(typeof settingsDefaults)["post"]> & {
		generateOgImages?: boolean;
	};
	theme?: Partial<(typeof settingsDefaults)["theme"]> & {
		banner?: {
			navbar?: {
				blur?: number;
				transparentMode?: "semi" | "full" | "semifull";
			};
			position?: string;
		};
		overlay?: { cardOpacity?: number; opacity?: number; blur?: number };
	};
	themeColor?: { hue?: number; defaultMode?: string };
	card?: { radius?: number; border?: boolean; followTheme?: boolean };
	imageOptimization?: { noReferrerDomains?: string[] };
	subtitle?: string;
	site_url?: string;
	lang?: string;
	name?: string;
	cardRadius?: number;
};

const settings =
	(
		Astro.locals as {
			settings?: LayoutSettings;
		}
	).settings ?? {};

// 站点图片优化配置（后台设置优先，静态配置兜底）
const imageOptimization =
	settings?.imageOptimization ?? siteConfig.imageOptimization;

// 导航栏模式（后台设置优先，静态配置兑底；static/fixed/dynamic）
// 导航栏配置统一走运行时入口（D1 的 nav 组；静态仅极端兜底）
const navbarMode = resolveNavbarMode(getNavbarConfig(Astro.locals));

const configHue =
	settings.hue ?? (settings?.themeColor ?? siteConfig.themeColor).hue;

const navbarTransparentMode =
	(settings?.theme?.banner ?? backgroundWallpaper.banner)?.navbar
		?.transparentMode || "semi";
// 判断是否应该显示顶部高光效果（只在full和semifull模式下显示）
const shouldShowTopHighlight =
	navbarTransparentMode === "full" || navbarTransparentMode === "semifull";

const NAVBAR_PANEL_MIN_BLUR = 2;
const navbarPanelBlur = Math.max(
	(settings?.theme?.banner ?? backgroundWallpaper.banner)?.navbar?.blur ?? 20,
	NAVBAR_PANEL_MIN_BLUR,
);

// 站点标题 / 副标题 / 描述：空值保持为空字符串，不再兜底成静态默认文案
const siteRuntime = getSiteConfig(Astro.locals);
const effectiveTitle = siteRuntime.title;
const effectiveDescription = siteRuntime.description;
let pageTitle: string;
const siteSubtitle = siteRuntime.subtitle;

// 拼接时跳过空段，避免出现多余的分隔符（如 " - " 悬空）
const siteIdentity = [effectiveTitle, siteSubtitle].filter(Boolean).join(" - ");
if (title) {
	pageTitle = siteIdentity ? `${title} - ${siteIdentity}` : title;
} else {
	pageTitle = siteIdentity;
}

let ogImageUrl: string | undefined;
if ((settings?.post ?? siteConfig.post).generateOgImages && postSlug) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
} else if (postCoverImage) {
	ogImageUrl = postCoverImage; // 已由文章页算成绝对 URL
}

if (!lang) {
	lang = `${settings?.lang ?? siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

// 作者个人页（/about/）绝对 URL，作为 Person.url
const effectiveSiteUrl =
	settings.siteUrl || (settings?.site_url ?? siteConfig.site_url);

// 运行时配置（后台可编辑；静态 config 仅兜底非可编辑结构项）
const siteCfgRuntime = getSiteConfig(Astro.locals);
const profileCfgRuntime = getProfileConfig(Astro.locals);

const avatarUrl = await getAuthorAvatarUrl(
	effectiveSiteUrl,
	profileCfgRuntime.avatar,
);
// 头像 preload：默认头像（未被后台替换）时预取静态文件，提前加载 LCP 图
const avatarPreloadUrl =
	(!settings?.avatar || settings?.avatar === profileConfig.avatar) &&
	profileConfig.avatar
		? await getRawImageUrl(profileConfig.avatar).catch(() => null)
		: null;
const aboutUrl = toAbsoluteUrl("/about/", effectiveSiteUrl) ?? effectiveSiteUrl;
// canonical 基于站点域名 + 路径（去查询串/Host 差异），避免参数变体产生重复收录
const canonicalUrl =
	toAbsoluteUrl(Astro.url.pathname, effectiveSiteUrl) ?? Astro.url.toString();

const siteLogo = await getSiteLogo(effectiveSiteUrl);

// SEO 组件入参（原内联在 head 中的表达式，值零改动）
const seoKeywords = (() => {
	const rawKw =
		(settings as { keywords?: unknown }).keywords ?? siteConfig.keywords;
	const kw =
		typeof rawKw === "string"
			? rawKw
			: Array.isArray(rawKw) && rawKw.length
				? rawKw.join(", ")
				: "";
	return kw as string;
})();
const seoAuthorName =
	(settings?.profile?.name as string | undefined) ??
	settings?.name ??
	profileConfig.name;
---

<!doctype html>
<html lang={siteLang} class:list={["bg-(--page-bg) text-[14px] md:text-[16px]", settings.cardBorder === true ? "enable-card-border" : ""]} data-wallpaper-mode={((settings?.["theme"])?.["mode"] ?? backgroundWallpaper.mode)} data-has-wallpaper={hasWallpaper ? "" : undefined} data-tag-style={settings.tagStyle || (settings?.["tagStyle"] ?? siteConfig.tagStyle) || "pill"} data-category-style={settings.categoryStyle || (settings?.["categoryStyle"] ?? siteConfig.categoryStyle) || "rectangle"}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline>
			@layer properties, theme, base, components, utilities;
		</style>
    {(settings.analytics?.googleAnalyticsId || analyticsConfig?.googleAnalyticsId) && (
            <GoogleAnalytics analyticsId={String(settings.analytics?.googleAnalyticsId || analyticsConfig?.googleAnalyticsId)} />
    )}
    {(settings.analytics?.microsoftClarityId || analyticsConfig?.microsoftClarityId) && (
            <MicrosoftClarity clarityId={String(settings.analytics?.microsoftClarityId || analyticsConfig?.microsoftClarityId)} />
    )}
        {(settings.analytics?.umamiId || analyticsConfig?.umamiAnalytics?.websiteId) && (
          <UmamiAnalytics
          websiteId={String(settings.analytics?.umamiId || analyticsConfig?.umamiAnalytics?.websiteId)}
          scriptUrl={String(settings.analytics?.umamiUrl || analyticsConfig?.umamiAnalytics?.scriptUrl || "")}
          replaysScriptUrl={analyticsConfig?.umamiAnalytics?.replaysScriptUrl}
          trackOutboundLinks={analyticsConfig?.umamiAnalytics?.trackOutboundLinks}
          collectWebVitals={analyticsConfig?.umamiAnalytics?.collectWebVitals}
          replays={analyticsConfig?.umamiAnalytics?.replays}
          />
        )}
        {analyticsConfig?.la51Analytics?.Id && (
            <La51Analytics
            analyticsId={analyticsConfig.la51Analytics.Id}
            sdkUrl={analyticsConfig.la51Analytics?.sdkUrl}
            ck={analyticsConfig.la51Analytics?.ck}
            autoTrack={analyticsConfig.la51Analytics?.autoTrack}
            hashMode={analyticsConfig.la51Analytics?.hashMode}
            screenRecord={analyticsConfig.la51Analytics?.screenRecord}
            />
    )}

    <SiteSeoMeta
      title={pageTitle}
      description={description}
      effectiveDescription={effectiveDescription}
      keywords={seoKeywords}
      authorName={seoAuthorName}
      canonicalUrl={canonicalUrl}
      avatarPreloadUrl={avatarPreloadUrl}
      wallpaperPreloadUrl={wallpaperPreloadUrl}
      wallpaperPreloadUrlMobile={wallpaperPreloadUrlMobile}
      siteName={effectiveTitle}
      ogImageUrl={ogImageUrl}
      siteLogo={siteLogo}
      ogTypeArticle={setOGTypeArticle}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    {
      isHomePageCheck && (
        <script
          is:inline
          type="application/ld+json"
          set:html={safeJsonLd(
            buildSiteGraph({
              site: effectiveSiteUrl,
              siteConfig: siteCfgRuntime,
              profileConfig: profileCfgRuntime,
              lang: siteLang,
              authorUrl: aboutUrl,
              avatarUrl,
              logo: siteLogo,
            }),
          )}
        />
      )
    }

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <FaviconLinks settings={settings} />

    {imageOptimization?.noReferrerDomains &&
     imageOptimization.noReferrerDomains.length > 0 && (
      <script
        is:inline
        define:vars={{
          noReferrerDomains: JSON.stringify(
            imageOptimization.noReferrerDomains
          ),
        }}
      >
        (function() {
          const domains = JSON.parse(noReferrerDomains);

          function matchesDomain(urlStr, patterns) {
            try {
              const urlObj = new URL(urlStr);
              const hostname = urlObj.hostname;

              return patterns.some(function(pattern) {
                const regexPattern = pattern.replace(/\./g, '\\.').replace(/\*/g, '.*');
                const regex = new RegExp('^' + regexPattern + '$');
                return regex.test(hostname);
              });
            } catch (e) {
              return false;
            }
          }

          function processImage(img) {
            if (!img.src || img.hasAttribute('referrerpolicy')) return;

            if (matchesDomain(img.src, domains)) {
              img.setAttribute('referrerpolicy', 'no-referrer');
            }
          }

          // 兜底扫描一次当前页面（构建期已处理的图片会因已有属性而快速跳过）
          document.querySelectorAll('img').forEach(processImage);

          // 使用 MutationObserver 监听动态加载/注入的图片
          const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
              mutation.addedNodes.forEach(function(node) {
                if (node.nodeName === 'IMG') {
                  processImage(node);
                }
                if (node.querySelectorAll) {
                  node.querySelectorAll('img').forEach(processImage);
                }
              });
            });
          });

          observer.observe(document.documentElement, {
            childList: true,
            subtree: true
          });
        })();
      </script>
    )}

    {/* i18n 词典内联：外置端点需额外一次请求（实测 0.82–1.07s / 12.6KB），
        内联后无需网络往返，且保证 island 水合前词典就绪（消除执行顺序竞态） */}
    <script is:inline set:html={`window.__FIREDRE_I18N__ = ${JSON.stringify(currentI18n)};`} />
    {allPostMeta.length > 0 && (
      <script is:inline set:html={`window.__allPostMetaCache = ${JSON.stringify(allPostMeta)};`} />
    )}
    <script
      is:inline
      define:vars={{
        PAGE_WIDTH,
        configHue,
        settingsVersion: (Astro.locals as { settingsVersion?: string }).settingsVersion ?? "",
        defaultMode: settings.defaultMode || (settings?.["themeColor"] ?? siteConfig.themeColor).defaultMode || "light",
        defaultWallpaperMode: ((settings?.["theme"])?.["mode"] ?? backgroundWallpaper.mode),
        isWallpaperSwitchable:
          (settings?.["panel"] ?? displaySettingsConfig).wallpaperModeSwitchable,
        darkTheme: getExpressiveCodeConfig(settings).darkTheme,
        lightTheme: getExpressiveCodeConfig(settings).lightTheme,
        baseUrl: import.meta.env.BASE_URL,
        cardTransparentOpacity: ((settings?.["theme"])?.["overlayCardOpacity"] ?? settings?.["theme"]?.["overlay"]?.cardOpacity ?? backgroundWallpaper.overlay?.cardOpacity) ?? 0.6,
        cardRadius: (settings?.["cardRadius"] ?? siteConfig.card?.radius) ?? 1,
      }}
    >
      // 资源自愈：陈旧 HTML 会引用已随部署消失的哈希资源（JS/CSS 404 后 Pages 返回
      // 404.html，浏览器按 MIME 拒绝执行 → 无交互/无样式，甚至整屏空白）。
      // 命中同源 script/link 加载失败即强制重载一次取新版本；限频 30s 防死循环。
      (function () {
        var HEAL_KEY = "assetHealAt";
        function heal(src) {
          if (src && src.charAt(0) !== "/" && src.indexOf(location.origin) !== 0) return;
          try {
            var last = Number(sessionStorage.getItem(HEAL_KEY) || 0);
            if (Date.now() - last < 30000) return;
            sessionStorage.setItem(HEAL_KEY, String(Date.now()));
          } catch (e) {
            return;
          }
          location.reload();
        }
        window.addEventListener("error", function (event) {
          var t = event.target;
          if (!t || t === window) return;
          if (t.tagName === "SCRIPT") heal(t.src);
          else if (t.tagName === "LINK" && t.rel === "stylesheet") heal(t.href);
        }, true);
      })();

      // 主题初始化 - 与setting-utils.ts保持一致
      const LIGHT_MODE = "light";
      const DARK_MODE = "dark";
      const SYSTEM_MODE = "system";

      // 设置实时感知（L2）：SSR 版本号落地为 data 属性，供 settings-live 模块比对
      document.documentElement.setAttribute("data-settings-version", String(settingsVersion));

      // 后台配置版本变化时清除访客偏好键，使面板与站点回落到新配置；
      // hue 仅在后台色相配置本身变化时重置，其余设置变更不影响用户自设色相
      var PREF_KEYS = ["wavesEnabled","gradientEnabled","sakuraEnabled","bannerTitleEnabled","bannerCarouselEnabled","cardBorderEnabled","cardFollowThemeEnabled","overlayOpacity","overlayBlur","overlayCardOpacity","wallpaperMode","postListLayout"];
      try {
        // 一次性迁移：历史版本面板挂载即写 hue，产生过「用户从未设置」的脏色相；
        // 只保留带 hueSource=user 标记的用户自设值
        if (localStorage.getItem("hue") !== null && localStorage.getItem("hueSource") !== "user") {
          localStorage.removeItem("hue");
        }
        if (localStorage.getItem("settingsVersion") !== String(settingsVersion)) {
          var hueChanged = localStorage.getItem("settingsHue") !== String(configHue);
          for (var pi = 0; pi < PREF_KEYS.length; pi++) localStorage.removeItem(PREF_KEYS[pi]);
          if (hueChanged) localStorage.removeItem("hue");
          localStorage.setItem("settingsVersion", String(settingsVersion));
          localStorage.setItem("settingsHue", String(configHue));
        }
      } catch (e) {}

      // 获取存储的主题，如果没有则使用默认值
      const theme = localStorage.getItem("theme") || defaultMode;

      function getSystemTheme() {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? DARK_MODE
          : LIGHT_MODE;
      }

      // 解析主题（如果是system模式，则获取系统主题）
      function resolveTheme(themeValue) {
        if (themeValue === SYSTEM_MODE) {
          return getSystemTheme();
        }
        return themeValue;
      }

      const resolvedTheme = resolveTheme(theme);
      const isDark = resolvedTheme === DARK_MODE;

      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      document.documentElement.setAttribute(
        "data-theme",
        isDark ? darkTheme : lightTheme
      );

      const hue = localStorage.getItem("hue") || configHue;
      document.documentElement.style.setProperty("--hue", hue);

      // 设置卡片透明度（全屏透明模式下使用），优先使用用户自定义值
      const storedCardOpacity = localStorage.getItem("overlayCardOpacity");
      const parsedCardOpacity = storedCardOpacity === null ? NaN : Number.parseFloat(storedCardOpacity);
      const resolvedCardOpacity = Number.isFinite(parsedCardOpacity)
        ? Math.min(1, Math.max(0, parsedCardOpacity))
        : cardTransparentOpacity;
      document.documentElement.style.setProperty("--card-transparent-opacity", String(resolvedCardOpacity));

      // 卡片圆角（rem），优先使用用户自定义值，否则用后台全局配置
      const storedRadius = localStorage.getItem("cardRadius");
      const parsedRadius = storedRadius === null ? NaN : Number.parseFloat(storedRadius);
      const resolvedRadius = Number.isFinite(parsedRadius) && parsedRadius >= 0
        ? Math.min(4, parsedRadius)
        : Number(cardRadius);
      document.documentElement.style.setProperty("--radius-large", resolvedRadius + "rem");

      // 初始化壁纸模式 - 在页面渲染前同步应用（其余布局由 CSS 属性选择器接管）
      const wallpaperMode = isWallpaperSwitchable
        ? localStorage.getItem("wallpaperMode") || defaultWallpaperMode
        : defaultWallpaperMode;

      document.documentElement.setAttribute(
        "data-wallpaper-mode",
        wallpaperMode
      );

      if (!window.__fireflyLayoutTransitionGuard) {
        window.__fireflyLayoutTransitionGuard = true;
        document.documentElement.setAttribute("data-layout-init", "");
        const removeLayoutInit = () =>
          document.documentElement.removeAttribute("data-layout-init");
        if (document.readyState === "complete") {
          requestAnimationFrame(removeLayoutInit);
        } else {
          window.addEventListener("load", removeLayoutInit, { once: true });
        }
      }

      // 初始化水波纹动画状态 - 在 html 元素上设置属性，CSS 会立即生效
      (function applyWavesEnabled() {
        const wavesEnabled = localStorage.getItem("wavesEnabled");
        if (wavesEnabled !== null) {
          document.documentElement.setAttribute("data-waves-enabled", wavesEnabled);
        }
      })();

      // 初始化渐变过渡状态 - 在 html 元素上设置属性，CSS 会立即生效
      (function applyGradientEnabled() {
        const gradientEnabled = localStorage.getItem("gradientEnabled");
        if (gradientEnabled !== null) {
          document.documentElement.setAttribute("data-gradient-enabled", gradientEnabled);
        }
      })();

      // 初始化横幅标题显示状态 - 在 html 元素上设置属性，CSS 会立即生效
      (function applyBannerTitleEnabled() {
        const bannerTitleEnabled = localStorage.getItem("bannerTitleEnabled");
        if (bannerTitleEnabled !== null) {
          document.documentElement.setAttribute("data-banner-title-enabled", bannerTitleEnabled);
        }
      })();
    </script>
    <style
      define:vars={{
        configHue,
        "page-width": `${settings.pageWidth ?? (settings?.["pageWidth"] ?? siteConfig.pageWidth) ?? PAGE_WIDTH}rem`,
        "navbar-panel-blur": `${navbarPanelBlur}px`,
        "banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
        "banner-height-non-home": `${BANNER_HEIGHT_NON_HOME}vh`,
        "banner-height": `${BANNER_HEIGHT}vh`,
      }}
    ></style>

    <slot name="head" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={(settings?.["profile"]?.["name"] as string | undefined) ?? (settings?.["name"] ?? profileConfig.name)}
      href={`${Astro.site}rss.xml`}
    />

    <FontSetup />
  </head>
  <body
    class="min-h-screen"
    class:list={[
      {
        "is-home": isHomePageCheck,
        "sticky-navbar": navbarMode === "fixed",
        "dynamic-navbar": navbarMode === "dynamic",
      },
    ]}
  >

    <script is:inline>
      (function () {
        const wm = document.documentElement.getAttribute("data-wallpaper-mode");
        if (!wm) return;
        document.body.classList.toggle(
          "wallpaper-transparent",
          wm === "overlay" || wm === "fullscreen",
        );
      })();
    </script>

    <div id="progress-bar"></div>

    {                                 }
    <script is:inline define:vars={{
      defaultBorder: (settings?.cardBorder ?? siteConfig.card.border) === true,
      defaultFollowTheme: (settings?.cardFollowTheme ?? siteConfig.card.followTheme) === true,
    }}>
      (function() {
        var stored = localStorage.getItem("cardBorderEnabled");
        var border = stored !== null ? stored === "true" : defaultBorder;
        if (border) document.documentElement.classList.add("enable-card-border");
        else document.documentElement.classList.remove("enable-card-border");

        stored = localStorage.getItem("cardFollowThemeEnabled");
        var follow = stored !== null ? stored === "true" : defaultFollowTheme;
        if (follow) document.body.classList.add("card-follow-theme-hue");
        else document.body.classList.remove("card-follow-theme-hue");
      })();
    </script>

    {shouldShowTopHighlight && <div class="top-gradient-highlight" />}
    <ConfigCarrier />
    {settings.music?.enabled !== false && <MusicManager />}
    <slot />

    {(((settings?.music?.showInNavbar) ?? musicPlayerConfig.showInNavbar) || ((settings?.music?.showInSidebar) ?? musicPlayerConfig.showInSidebar) !== false) && settings.music?.enabled !== false && (
      <MusicPlayerView />
    )}

    <script is:inline define:vars={{ fireflySettings: toClientSettings(settings) }}>
      // 后台站点设置注入客户端（樱花等客户端组件的开关/参数读取）
      window.__FIREFLY_SETTINGS__ = fireflySettings;
    </script>
    {settings.effects?.sakura !== false && <SakuraEffect />}

    {settings.effects?.waves !== false && <WavesEffect />}

    <script>import "../scripts/markdown-enhancer";</script>
    <script>import "@/utils/settings-live";</script>
    <FancyboxManager />

    <CodeGroupManager />

    <GithubCardManager />
  {settings.ads?.enabled !== false && settings.ads?.adSenseId ? (
    <script is:inline data-ad-client={String(settings.ads.adSenseId)} async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
  ) : null}
  {settings.ads?.enabled !== false && settings.ads?.customCode ? (
    <div class="firedre-ads" set:html={settings.ads.customCode} />
  ) : null}

