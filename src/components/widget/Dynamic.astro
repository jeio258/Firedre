---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import DynamicSidebar from "@/components/widget/DynamicSidebar.svelte";
import { dynamicConfig } from "@/config";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { url } from "@/utils/url-utils";

// 运行时站点配置（后台可编辑；静态 config 为兜底）



interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const configuredLimit = widgetConfig?.specificConfig?.dynamic?.limit ?? 3;
const limit = Math.max(1, Math.floor(configuredLimit));

const apiUrl = ((((settings as any)?.["dynamic"]) as any)?.["apiUrl"] ?? dynamicConfig.apiUrl)?.startsWith("http")
	? ((((settings as any)?.["dynamic"]) as any)?.["apiUrl"] ?? dynamicConfig.apiUrl)
	: url(((((settings as any)?.["dynamic"]) as any)?.["apiUrl"] ?? dynamicConfig.apiUrl) || "/api/dynamic.json");
const memos = ((((settings as any)?.["dynamic"]) as any)?.["memos"] ?? dynamicConfig.memos);
---

{
	getSiteConfig(Astro.locals).pages.dynamic && (
		<WidgetLayout
			name={i18n(I18nKey.latestDynamics)}
			showTitle={showTitle}
			id="latest-dynamics"
			class={className}
			style={style}
		>
			<DynamicSidebar client:visible apiUrl={apiUrl} limit={limit} {memos} />
			<a
				class="btn-plain mt-2 flex items-center justify-center gap-1 rounded-lg p-1.5
					text-sm text-(--primary)"
				href={url("/dynamic/")}
			>
				<Icon
					name="material-symbols:dynamic-feed-rounded"
					class="size-4.5"
					aria-hidden="true"
				/>
				<span>{i18n(I18nKey.moreDynamics)}</span>
				<span data-dynamic-count class="opacity-60"></span>
			</a>
		</WidgetLayout>
	)
}