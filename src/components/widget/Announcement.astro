---
import { getNotice } from "@server/notice/service";
import { getAnnouncementConfig } from "@shared/config/runtime";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { cfEnv } from "@/lib/api";
import type { WidgetComponentConfig } from "@/types/config";
import type { NoticeSection } from "../../../types/notice";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// Firedre：公告内容单一真源为 D1 notice_board（后台公告管理页），
// site_settings.announcement 仅存启停开关（显式 false 强制隐藏）
const announcement = getAnnouncementConfig(Astro.locals);
const notice = await getNotice(cfEnv);
const title = notice?.title || i18n(I18nKey.announcement);
const sections: NoticeSection[] = notice?.sections ?? [];
const link = announcement.link;
const closable = announcement.closable !== false;

// 标题、正文、sections 全空则不渲染（title 的 i18n 兜底不参与判断）。
const enabled = announcement.enable !== false;
const hasContent = Boolean(notice?.title?.trim() || sections.length);
if (!enabled || !hasContent) {
	return null;
}
---

<WidgetLayout
  name={title}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  <div>

    <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3 space-y-2">
      {
        sections.map((section) => (
          <div>
            {
              section.label && (
                <div class="text-xs font-medium text-(--primary-text) opacity-80 mb-1">
                  {section.label}
                </div>
              )
            }
            <div class="space-y-1">
              {
                section.lines.map((line) =>
                  line.url ? (
                    <a
                      href={line.url}
                      class="block hover:text-(--primary) transition"
                    >
                      {line.text}
                    </a>
                  ) : (
                    <div>{line.text}</div>
                  ),
                )
              }
            </div>
          </div>
        ))
      }
    </div>

    <div class="flex items-center justify-between gap-3">
      <div>
        {
          link && link.enable !== false && (
            <a
              href={link.url}
              target={link.external ? "_blank" : "_self"}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {link.text}
            </a>
          )
        }
      </div>

      {
        closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
            onclick="this.closest('widget-layout').style.display='none'"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon name="fa7-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
</WidgetLayout>
