---
import { url } from "@shared/utils/url-utils";
// 文章页「分享/赞助」块：原在 posts/[...slug].astro 的加密/公开两个分支里各出现一次
// （结构完全相同），抽取为共享组件。逐字搬运，UI 与拆分前完全一致。
import { Icon } from "astro-icon/components";
import SharePoster from "@/components/misc/SharePoster.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	shareEnabled: boolean;
	sponsorEnabled: boolean;
	title: string;
	author: string;
	description: string;
	pubDate: string;
	coverImage?: string | null;
	coverImageSelector?: string | null;
	siteTitle: string;
	avatar?: string | null;
	avatarSelector?: string | null;
}

const {
	shareEnabled,
	sponsorEnabled,
	title,
	author,
	description,
	pubDate,
	coverImage,
	coverImageSelector,
	siteTitle,
	avatar,
	avatarSelector,
} = Astro.props;
---

{
  (shareEnabled || sponsorEnabled) && (
    <div class="mb-6 rounded-xl onload-animation">
      <div class="p-6 bg-(--license-block-bg) rounded-xl">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3 flex-1">
            <div class="h-12 w-12 rounded-lg bg-(--primary-fill) flex items-center justify-center text-(--primary-on-fill) shrink-0">
              <Icon
                name={sponsorEnabled
                  ? "material-symbols:favorite"
                  : "material-symbols:share"}
                class="text-2xl"
              />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                {
                  sponsorEnabled
                    ? i18n(I18nKey.sponsorButton)
                    : i18n(I18nKey.shareOnSocial)
                }
              </h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                {
                  sponsorEnabled
                    ? i18n(I18nKey.sponsorButtonText)
                    : i18n(I18nKey.shareOnSocialDescription)
                }
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            {
              shareEnabled && (
                <SharePoster
                  client:idle
                  title={title}
                  author={author}
                  description={description}
                  pubDate={pubDate}
                  coverImage={coverImage}
                  coverImageSelector={coverImageSelector}
                  url={Astro.url.href}
                  siteTitle={siteTitle}
                  avatar={avatar}
                  avatarSelector={avatarSelector}
                />
              )
            }
            {
              sponsorEnabled && (
                <a
                  href={url("/sponsor/")}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary-fill) text-(--primary-on-fill) rounded-lg font-medium hover:bg-(--primary-fill)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap"
                >
                  <span>{i18n(I18nKey.sponsor)}</span>
                  <Icon name="fa7-solid:arrow-right" class="text-sm" />
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  )
}
