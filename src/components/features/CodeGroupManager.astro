<script>
  const GROUP_SELECTOR = ".rehype-code-group";
  const TAB_SELECTOR = ".rcg-tab";
  const BLOCK_SELECTOR = ".rcg-block";

  const getTabs = (group: Element): HTMLElement[] =>
    Array.from(group.querySelectorAll<HTMLElement>(`:scope > .rcg-tab-container > ${TAB_SELECTOR}`));

  const getBlocks = (group: Element): HTMLElement[] =>
    Array.from(group.querySelectorAll<HTMLElement>(`:scope > ${BLOCK_SELECTOR}`));

  function activate(group: Element, index: number, focusTab = false) {
    const tabs = getTabs(group);
    const blocks = getBlocks(group);
    if (tabs.length === 0) return;

    const target = Math.max(0, Math.min(index, tabs.length - 1));

    tabs.forEach((tab, i) => {
      const selected = i === target;
      tab.classList.toggle("active", selected);
      tab.setAttribute("aria-selected", selected ? "true" : "false");
    });

    blocks.forEach((block, i) => {
      const selected = i === target;
      block.classList.toggle("active", selected);
      if (selected) block.removeAttribute("hidden");
      else block.setAttribute("hidden", "true");
    });

    if (focusTab) tabs[target].focus({ preventScroll: true });
  }

  function resolveTab(target: EventTarget | null) {
    if (!(target instanceof Element)) return null;
    const tab = target.closest<HTMLElement>(TAB_SELECTOR);
    const group = tab?.closest(GROUP_SELECTOR);
    if (!tab || !group) return null;
    const index = getTabs(group).indexOf(tab);
    if (index === -1) return null;
    return { group, index };
  }

  document.addEventListener("click", (event) => {
    const found = resolveTab(event.target);
    if (found) activate(found.group, found.index);
  });

  document.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey) return;

    const found = resolveTab(event.target);
    if (!found) return;

    const count = getTabs(found.group).length;
    let next: number;

    switch (event.key) {
      case "ArrowRight":
        next = (found.index + 1) % count;
        break;
      case "ArrowLeft":
        next = (found.index - 1 + count) % count;
        break;
      case "Home":
        next = 0;
        break;
      case "End":
        next = count - 1;
        break;
      default:
        return;
    }

    event.preventDefault();
    activate(found.group, next, true);
  });
</script>
