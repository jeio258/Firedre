---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};

import { Font } from "astro:assets";
import { fontConfig } from "@/config";
import { collectUsedFontCssVars } from "@/utils/fontHelper";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

const allCssVars = ((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable)
	? collectUsedFontCssVars(fontConfig)
	: new Set<string>();

const selectedIds: string[] =
	((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable) && ((((settings as any)?.["font"]) as any)?.["selected"] ?? fontConfig.selected)
		? Array.isArray(((((settings as any)?.["font"]) as any)?.["selected"] ?? fontConfig.selected))
			? ((((settings as any)?.["font"]) as any)?.["selected"] ?? fontConfig.selected)
			: [((((settings as any)?.["font"]) as any)?.["selected"] ?? fontConfig.selected)]
		: [];

const SYSTEM_FONT_STACK =
	"system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";

const MONO_FONT_STACK =
	'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace';
const selectedFontVars = selectedIds.filter((v) => v !== "system");
const bodyFontFamily =
	selectedFontVars.length > 0
		? [...selectedFontVars.map((v) => `var(${v})`), SYSTEM_FONT_STACK].join(
				", ",
			)
		: SYSTEM_FONT_STACK;

// 各区域字体 CSS 变量值
const bannerTitleFontVar = ((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable)
	? ((((settings as any)?.["font"]) as any)?.["bannerTitleFont"] ?? fontConfig.bannerTitleFont) || ""
	: "";
const bannerSubtitleFontVar = ((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable)
	? ((((settings as any)?.["font"]) as any)?.["bannerSubtitleFont"] ?? fontConfig.bannerSubtitleFont) || ""
	: "";
const navbarTitleFontVar = ((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable)
	? ((((settings as any)?.["font"]) as any)?.["navbarTitleFont"] ?? fontConfig.navbarTitleFont) || ""
	: "";
const codeFontVar = ((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable) ? ((((settings as any)?.["font"]) as any)?.["codeFont"] ?? fontConfig.codeFont) || "" : "";

const codeFontFamily = codeFontVar
	? `var(${codeFontVar}, ${MONO_FONT_STACK})`
	: MONO_FONT_STACK;
---

{Array.from(allCssVars).map((cssVar) => (
  <Font
    cssVariable={cssVar as any}
    preload={selectedFontVars.includes(cssVar)}
  />
))}

<style
  set:html={`
  :root {
    --font-code: ${codeFontFamily};
    ${bannerTitleFontVar ? `--font-banner-title: var(${bannerTitleFontVar}, inherit);` : ""}
    ${bannerSubtitleFontVar ? `--font-banner-subtitle: var(${bannerSubtitleFontVar}, inherit);` : ""}
    ${navbarTitleFontVar ? `--font-navbar-title: var(${navbarTitleFontVar}, inherit);` : ""}
  }

  ${
		((((settings as any)?.["font"]) as any)?.["enable"] ?? fontConfig.enable) &&
		(bannerTitleFontVar ||
			bannerSubtitleFontVar ||
			navbarTitleFontVar ||
			selectedFontVars.length > 0)
			? `body {
      font-family: ${bodyFontFamily};
    }`
			: ""
	}
`}
/>

<script>
  // 字体加载完成事件
  if (document.fonts && typeof document.fonts.ready !== "undefined") {
    document.fonts.ready
      .then(() => {
        document.dispatchEvent(new CustomEvent("fontsLoaded"));
      })
      .catch((error) => {
        console.warn("Font loading failed:", error);
      });
  }
</script>
