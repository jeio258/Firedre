---
import { getCommentConfig } from "@/config/runtime";

// 运行时评论配置（后台可编辑；静态 config 为兜底）
const comment = getCommentConfig(Astro.locals);



interface Props {
	path: string;
}

const config = {
	...{
		...(comment.waline ?? {}),
		serverURL: comment.waline?.serverURL || "",
	},
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	...(comment.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config }}>
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
    const rawPath = new URLSearchParams(window.location.search).get("path");
    // 仅接受站内相对路径作为评论线程标识，拒绝外部 scheme/控制字符注入
    const requestedPath = rawPath && /^\/[^\s"'<>]*$/.test(rawPath) ? rawPath : null;
    const effectiveConfig = requestedPath
      ? { ...config, path: requestedPath }
      : config;
    try {
      init(effectiveConfig);
    } catch (error) {
      console.error("[Waline] Failed to initialize:", error);
    }
  </script>
</div>
