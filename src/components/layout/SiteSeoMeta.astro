---
// 站点 SEO/社交分享 meta（自 Layout.astro 拆分，输出与拆分前逐字一致：
// 深链/OG/Twitter/预加载标签；keywords 与 authorName 在 Layout frontmatter 计算后传入）
interface Props {
	title: string;
	description?: string | null;
	effectiveDescription?: string | null;
	keywords?: string;
	authorName?: string;
	canonicalUrl: string;
	avatarPreloadUrl?: string | null;
	wallpaperPreloadUrl?: string | null;
	wallpaperPreloadUrlMobile?: string | null;
	siteName: string;
	ogImageUrl?: string | null;
	siteLogo?: string | { url?: string } | null;
	ogTypeArticle?: boolean;
	publishedTime?: string | Date | null;
	modifiedTime?: string | Date | null;
}

const {
	title,
	description,
	effectiveDescription,
	keywords,
	authorName,
	canonicalUrl,
	avatarPreloadUrl,
	wallpaperPreloadUrl,
	wallpaperPreloadUrlMobile,
	siteName,
	ogImageUrl,
	siteLogo,
	ogTypeArticle,
	publishedTime,
	modifiedTime,
} = Astro.props;

void siteName;
---

    <title>{title}</title>
    <meta
      name="description"
      content={description || effectiveDescription || title}
    />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <meta name="author" content={authorName} />

    <link rel="canonical" href={canonicalUrl} />
    {avatarPreloadUrl && <link rel="preload" as="image" href={avatarPreloadUrl} fetchpriority="high" />}
    {wallpaperPreloadUrl && <link rel="preload" as="image" href={wallpaperPreloadUrl} media="(min-width: 1024px)" fetchpriority="high" />}
    {wallpaperPreloadUrlMobile && <link rel="preload" as="image" href={wallpaperPreloadUrlMobile} media="(max-width: 1023px)" fetchpriority="high" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description || effectiveDescription || title}
    />
    <meta
      property="og:image"
      content={ogImageUrl ?? (typeof siteLogo === "string" ? siteLogo : siteLogo?.url)}
    />
    <meta
      name="twitter:image"
      content={ogImageUrl ?? (typeof siteLogo === "string" ? siteLogo : siteLogo?.url)}
    />
    {
      ogTypeArticle ? (
        <>
          <meta property="og:type" content="article" />
          {publishedTime && (
            <meta
              property="article:published_time"
              content={publishedTime instanceof Date ? publishedTime.toISOString() : publishedTime}
            />
          )}
          {modifiedTime && (
            <meta
              property="article:modified_time"
              content={modifiedTime instanceof Date ? modifiedTime.toISOString() : modifiedTime}
            />
          )}
        </>
      ) : (
        <meta property="og:type" content="website" />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content={description || effectiveDescription || title}
    />
