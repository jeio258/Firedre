---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
import { backgroundWallpaper, siteConfig } from "@/config";

// 运行时站点配置（后台可编辑；静态 config 为兜底）


---

<!-- 全局配置载体 -->
<div
  id="config-carrier"
  data-hue={((settings as any)?.["hue"] ?? (((settings as any)?.["themeColor"] ?? siteConfig.themeColor).hue))}
  data-wallpaper-mode={((((settings as any)?.["theme"]) as any)?.["mode"] ?? backgroundWallpaper.mode)}
>
</div>
