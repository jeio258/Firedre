---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};

import { getWallpaperConfig } from "@shared/config/runtime";
import { siteConfig } from "@/config";

// 运行时站点配置（后台可编辑；静态 config 为兜底）
---

<div
  id="config-carrier"
  data-hue={siteConfig.themeColor.hue}
  data-wallpaper-mode={getWallpaperConfig(Astro.locals).mode}
>
</div>
