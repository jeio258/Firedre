---
import FaviconLinks from "./FaviconLinks.astro";

interface Props {
	defaultMode?: string;
	defaultHue?: string | number;
}
const { defaultMode = "light", defaultHue = "165" } = Astro.props;
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
---
<meta name="robots" content="noindex, nofollow" />
<FaviconLinks settings={settings} />
<link rel="stylesheet" href="/admin/admin.css" />
<link rel="stylesheet" href="/admin/fa-subset.css" />
<!-- Markdown 编辑器（EasyMDE）样式由编辑器组件的 import 注入；
     后台为 SPA 视图切换，首次注入后全后台生效 -->
<style is:inline set:html={`html{--hue:${defaultHue}}`}></style>
<script is:inline define:vars={{ defaultMode, defaultHue }}>
	(function () {
		try {
			var DARK = "dark", SYSTEM = "system";
			var theme = localStorage.getItem("theme") || defaultMode;
			var isDark = theme === SYSTEM
				? window.matchMedia("(prefers-color-scheme: dark)").matches
				: theme === DARK;
			document.documentElement.classList.toggle("dark", isDark);
			document.documentElement.setAttribute("data-theme", isDark ? "one-dark-pro" : "one-light");
			var hue = localStorage.getItem("hue") || defaultHue;
			document.documentElement.style.setProperty("--hue", hue);
		} catch (e) {}
	})();
</script>
