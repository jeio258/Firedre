---
import fs from "node:fs";
import path from "node:path";
import {
	listEnabledSiteLinks,
	type SiteLinkView,
} from "@server/siteLinks/service";
import { footerConfig } from "@/config";
import { getFooterConfig, getProfileConfig } from "@/config/runtime";
import { url } from "@/utils/url-utils";
import { cfEnv } from "../../lib/api";

const footerConfigRuntime = getFooterConfig(Astro.locals);
const profileConfigRuntime = getProfileConfig(Astro.locals);

const footerLinks: SiteLinkView[] = await listEnabledSiteLinks(
	cfEnv,
	"footer",
	Astro.locals,
);

const currentYear = new Date().getFullYear();

// 读取FooterConfig.html文件内容
let customFooterHtml = "";
if (footerConfigRuntime.enable ?? footerConfig.enable) {
	try {
		const footerConfigPath = path.join(
			process.cwd(),
			"src",
			"config",
			"FooterConfig.html",
		);
		customFooterHtml = fs.readFileSync(footerConfigPath, "utf-8");
		customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
	} catch (error) {
		console.warn(
			"FooterConfig.html文件读取失败:",
			error instanceof Error ? error.message : String(error),
		);
	}
}
---

<!-- 页脚：普通流位于文档末尾。site-footer 是 immersive-reading 的隐藏选择器，
     pointer-events-auto 用于覆盖首页 banner 下父级的 pointer-events: none，两者勿删 -->
<footer class="site-footer pointer-events-auto pb-4 md:pb-6">
	<div
		class="transition border-t border-black/10 dark:border-white/15 mt-10 mb-5 border-dashed mx-32"
	>
	</div>

	<div class="transition flex flex-col items-center justify-center px-6">
  <div class="transition text-50 text-sm text-center wrap">
    <div class="mb-2">
      {customFooterHtml && <div set:html={customFooterHtml} />}
      {footerConfigRuntime.customHtml && <div set:html={String(footerConfigRuntime.customHtml)} />}
    </div>
    <div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
      &copy; <span id="copyright-year">{footerConfigRuntime.startYear ? `${footerConfigRuntime.startYear}-${currentYear}` : currentYear}</span>
      {profileConfigRuntime.name}. All Rights Reserved.
      <span aria-hidden="true">/</span>
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        rel="noopener noreferrer"
        href={url("rss.xml")}>RSS</a
      >
      <span aria-hidden="true">/</span>
      <a
        class="transition link text-(--primary) font-medium"
        target="_blank"
        rel="noopener noreferrer"
        href={url("sitemap.xml")}>Sitemap</a
      >
    </div>
    {footerConfigRuntime.text && (
      <div class="mx-0.5 my-2.5 flex justify-center flex-wrap">{String(footerConfigRuntime.text)}</div>
    )}
    {footerConfigRuntime.icp && (
      <div class="mx-0.5 my-2.5 flex justify-center flex-wrap">
        <a class="link" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{String(footerConfigRuntime.icp)}</a>
      </div>
    )}
    <div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
      <span>Powered by</span>
      <a class="transition link text-(--primary) font-medium" target="_blank" rel="noopener noreferrer" href="https://astro.build">Astro</a>
      <span aria-hidden="true">&</span>
      {footerLinks.map((fl) => (
        <a class="transition link text-(--primary) font-medium" target={/^https?:\/\//i.test(fl.url) ? "_blank" : undefined} href={fl.url}>{fl.name}</a>
      ))}
    </div>
    </div>
  </div>
</footer>
