<ol class="timeline">
	<slot />
</ol>

<style>
	.timeline {

		--timeline-marker-size: 1.25rem;

		position: relative;
		list-style: none;
		margin: var(--spacing-2xl) 0;
		padding: 0;
	}

	.timeline::before {
		content: "";
		position: absolute;
		left: calc(var(--timeline-marker-size) / 2 - 1px);
		top: var(--spacing-xs);
		bottom: var(--spacing-xs);
		width: 2px;
		background: var(--line-divider);
		border-radius: var(--radius-full);
	}
</style>
