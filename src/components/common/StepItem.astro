---
import { ICONS, type IconName } from "./mdx-icons";

interface Props {
	title?: string;
	type?: "default" | "tip" | "note" | "important" | "warning" | "caution";
	icon?: IconName;
}

const { title, type = "default", icon } = Astro.props;
const iconHtml = icon ? ICONS[icon] : undefined;
---

<li class="step-item" data-type={type}>
	<span class="step-marker" aria-hidden="true">
		{iconHtml && <span class="step-marker-icon" set:html={iconHtml}></span>}
	</span>
	<div class="step-content">
		{title && <div class="step-item-title">{title}</div>}
		<div class="step-item-body">
			<slot />
		</div>
	</div>
</li>

<style>

	.step-item {
		--step-bg: var(--primary);
		--step-ring: color-mix(in srgb, var(--primary) 22%, transparent);

		counter-increment: step;
		position: relative;
		z-index: 1;
		display: flex;
		gap: var(--spacing-lg);
		margin: 0;
		padding: 0 0 var(--spacing-2xl);
	}

	.step-item[data-type="tip"] {
		--step-bg: var(--admonitions-color-tip);
		--step-ring: color-mix(in srgb, var(--admonitions-color-tip) 22%, transparent);
	}
	.step-item[data-type="note"] {
		--step-bg: var(--admonitions-color-note);
		--step-ring: color-mix(in srgb, var(--admonitions-color-note) 22%, transparent);
	}
	.step-item[data-type="important"] {
		--step-bg: var(--admonitions-color-important);
		--step-ring: color-mix(in srgb, var(--admonitions-color-important) 22%, transparent);
	}
	.step-item[data-type="warning"] {
		--step-bg: var(--admonitions-color-warning);
		--step-ring: color-mix(in srgb, var(--admonitions-color-warning) 22%, transparent);
	}
	.step-item[data-type="caution"] {
		--step-bg: var(--admonitions-color-caution);
		--step-ring: color-mix(in srgb, var(--admonitions-color-caution) 22%, transparent);
	}

	.step-item:last-child {
		padding-bottom: 0;
	}

	.step-marker {
		flex-shrink: 0;
		width: var(--steps-marker-size, 1.5rem);
		height: var(--steps-marker-size, 1.5rem);
		margin-top: 0.25rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-full);
		background: var(--step-bg);
		box-shadow: 0 0 0 3px var(--step-ring);
		color: #fff;
		font-size: 0.8rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.step-marker::before {
		content: counter(step);
	}

	.step-item:has(.step-marker-icon) .step-marker::before {
		content: none;
	}

	.step-marker-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	.step-marker-icon :global(svg) {
		width: 0.8rem;
		height: 0.8rem;
	}

	.step-content {
		flex: 1;
		min-width: 0;
	}

	.step-item-title {
		margin-top: 0.125rem;
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--deep-text);
	}

	:global(.dark) .step-item-title {
		color: var(--btn-content);
	}

	.step-item-body {
		margin-top: var(--spacing-sm);
	}

	.step-item-body > :first-child {
		margin-top: 0;
	}

	.step-item-body > :last-child {
		margin-bottom: 0;
	}
</style>
