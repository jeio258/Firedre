---

<ol class="steps">
	<slot />
</ol>

<style>
	.steps {

		--steps-marker-size: 1.5rem;

		counter-reset: step;
		position: relative;
		list-style: none;
		margin: var(--spacing-2xl) 0;
		padding: 0;
	}

	.steps::before {
		content: "";
		position: absolute;
		left: calc(var(--steps-marker-size) / 2 - 1px);
		top: var(--spacing-xs);
		bottom: var(--spacing-xs);
		width: 2px;
		background: var(--line-divider);
		border-radius: var(--radius-full);
	}
</style>
