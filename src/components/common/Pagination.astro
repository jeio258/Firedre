---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import PageJump from "@/components/common/PageJump.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";
import {
	computePaginationPages,
	PAGINATION_ELLIPSIS,
} from "@/utils/pagination-window";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = PAGINATION_ELLIPSIS;

const className = Astro.props.class;

const pages = computePaginationPages(page.currentPage, page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};

const jumpHrefTemplate = url("/{page}/");
const jumpHrefFirst = url("/");
---

<div class:list={[className, "pagination-wrapper flex flex-col gap-4 items-center"]} style={style}>

  <div class="flex flex-row gap-3 justify-center" role="navigation" aria-label={i18n(I18nKey.postList)}>

    <div class="mobile-pagination flex items-center gap-3">
      <a
        href={page.url.prev || "#"}
        aria-label={i18n(I18nKey.paginationPrev)}
        aria-disabled={!page.url.prev ? "true" : "false"}
        tabindex={!page.url.prev ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.prev,
            "opacity-50": !page.url.prev,
            "cursor-not-allowed": !page.url.prev,
          },
        ]}
      >
        <Icon
          name="material-symbols:chevron-left-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>

      <div class="btn-card flex items-center rounded-(--radius-large) px-4 h-11 gap-1.5">
        <PageJump
          client:idle
          variant="current"
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          hrefTemplate={jumpHrefTemplate}
          hrefFirst={jumpHrefFirst}
        />
        <span class="text-sm text-neutral-500 dark:text-neutral-500">/</span>
        <span class="text-base font-bold text-neutral-700 dark:text-neutral-300">{page.lastPage}</span>
      </div>

      <a
        href={page.url.next || "#"}
        aria-label={i18n(I18nKey.paginationNext)}
        aria-disabled={!page.url.next ? "true" : "false"}
        tabindex={!page.url.next ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.next,
            "opacity-50": !page.url.next,
            "cursor-not-allowed": !page.url.next,
          },
        ]}
      >
        <Icon
          name="material-symbols:chevron-right-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
    </div>

    <div class="desktop-pagination flex items-center gap-3">
      <a
        href={page.url.prev || "#"}
        aria-label={i18n(I18nKey.paginationPrev)}
        aria-disabled={!page.url.prev ? "true" : "false"}
        tabindex={!page.url.prev ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.prev,
            "opacity-50": !page.url.prev,
            "cursor-not-allowed": !page.url.prev,
          },
        ]}
      >
        <Icon
          name="material-symbols:chevron-left-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
      {
        pages.map((p) => {
          if (p == HIDDEN)
            return (
              <PageJump
                client:idle
                variant="ellipsis"
                currentPage={page.currentPage}
                lastPage={page.lastPage}
                hrefTemplate={jumpHrefTemplate}
                hrefFirst={jumpHrefFirst}
              />
            );
          if (p == page.currentPage)
            return (
              <div
                class="h-11 w-11 rounded-(--radius-large) bg-(--primary) flex items-center justify-center
                        font-bold text-white dark:text-black/70"
                aria-current="page"
              >
                {p}
              </div>
            );
          return (
            <a
              href={url(getPageUrl(p))}
              aria-label={`${i18n(I18nKey.paginationPage)} ${p}`}
              class="btn-card w-11 h-11 rounded-(--radius-large) overflow-hidden active:scale-[0.85] font-bold text-neutral-700 dark:text-neutral-300"
            >
              {p}
            </a>
          );
        })
      }
      <a
        href={page.url.next || "#"}
        aria-label={i18n(I18nKey.paginationNext)}
        aria-disabled={!page.url.next ? "true" : "false"}
        tabindex={!page.url.next ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.next,
            "opacity-50": !page.url.next,
            "cursor-not-allowed": !page.url.next,
          },
        ]}
      >
        <Icon
          name="material-symbols:chevron-right-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</div>

<style>
  .pagination-wrapper {
    max-width: 100%;
  }

  .mobile-pagination {
    display: flex;
    padding: 0 1rem;
  }

  .desktop-pagination {
    display: none;
  }

  @media (min-width: 1024px) {
    .mobile-pagination {
      display: none;
    }
    .desktop-pagination {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .mobile-pagination {
      padding: 0 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .mobile-pagination {
      padding: 0 0.25rem;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .mobile-pagination a,
    .mobile-pagination div {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
