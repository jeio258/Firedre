---
import { Icon } from "astro-icon/components";

interface Props {
	id: string;
	icon: string;

	toggleIcon?: string;
	ariaLabel?: string;
	onclick?: string;
	class?: string;
}

const {
	id,
	icon,
	toggleIcon,
	ariaLabel,
	onclick,
	class: className = "",
} = Astro.props;
---

<div
  id={id}
  class:list={["floating-btn", className, "card-base flex items-center rounded-2xl overflow-hidden transition"]}
  onclick={onclick}
>
  <button
    aria-label={ariaLabel}
    class:list={["h-full w-full rounded-2xl", toggleIcon && "has-toggle-icon"]}
  >
    <Icon name={icon} class:list={["mx-auto", toggleIcon && "icon-default"]} />
    {toggleIcon && <Icon name={toggleIcon} class="icon-toggled" />}
  </button>
</div>

<style lang="stylus">
.floating-btn
    color: var(--primary)
    font-size: 1.5rem
    font-weight: bold
    width: 3rem
    height: 3rem

    opacity: 1
    cursor: pointer
    pointer-events: auto

    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
    border-radius: 1rem
    backdrop-filter: blur(12px)
    background-color: var(--card-bg)
    border: 1px solid rgba(0, 0, 0, 0.1)
    flex-shrink: 0
    overflow: hidden

    :global(svg)
        font-size: 1.6rem
        opacity: 1
        transition: opacity 0.2s ease 0.1s                                    

    button.has-toggle-icon
        display: grid
        place-items: center

        :global(svg)
            grid-area: 1 / 1

    :global(svg.icon-toggled)
        display: none

    &.toggled

        background-color: var(--btn-regular-bg)

        :global(svg.icon-default)
            display: none
        :global(svg.icon-toggled)
            display: block

        &:hover
            background-color: var(--btn-regular-bg-hover)

    &.hide

        transform: scale(0.5)
        opacity: 0
        pointer-events: none

        height: 0 !important
        width: 0 !important
        margin: 0 !important
        border-width: 0 !important
        padding: 0 !important

        :global(svg)
            opacity: 0
            transition: opacity 0.1s ease                            

    &:active
        transform: scale(0.9)

    &:hover
        background-color: var(--btn-card-bg-hover)
        color: var(--primary)
        box-shadow: var(--shadow-button)

:global(.dark) .floating-btn
    background-color: var(--card-bg)
    border: 1px solid rgba(255, 255, 255, 0.15)
    color: var(--primary, #60a5fa)

    &:hover
        background-color: var(--btn-card-bg-hover)
        color: var(--primary)
        box-shadow: var(--shadow-button-dark)

    &.toggled
        background-color: var(--btn-regular-bg)

        &:hover
            background-color: var(--btn-regular-bg-hover)

@media (max-width: 768px)
    .floating-btn
        width: 3rem
        height: 3rem
        font-size: 1.5rem
        border-radius: 0.75rem
        :global(svg)
            font-size: 1.5rem

@media (max-width: 480px)
    .floating-btn
        width: 2.5rem
        height: 2.5rem
        font-size: 1.25rem
        border-radius: 0.5rem
        :global(svg)
            font-size: 1.2rem

@media (max-width: 360px)
    .floating-btn
        width: 2rem
        height: 2rem
        font-size: 1rem
        border-radius: 0.375rem
        :global(svg)
            font-size: 1rem

@media (max-width: 320px)
    .floating-btn
        width: 1.75rem
        height: 1.75rem
        font-size: 0.875rem
        border-radius: 0.25rem
        :global(svg)
            font-size: 0.875rem

.floating-btn
    min-width: 0
    min-height: 0
    padding: 0.25rem
    border-radius: 1rem !important

    &.hide
        padding: 0

@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi)
    .floating-btn
        image-rendering: -webkit-optimize-contrast
        image-rendering: crisp-edges
</style>