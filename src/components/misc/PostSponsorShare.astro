---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";
import SharePoster from "./SharePoster.svelte";

interface Props {
	showSharePoster: boolean;
	showSponsorInPost: boolean;
	title: string;
	author: string;
	description: string;
	pubDate: string;
	coverImage?: string | null;
	coverImageSelector?: string | null;
	url: string;
	siteTitle: string;
	avatar?: string | null;
	avatarSelector?: string | null;
}

const {
	showSharePoster,
	showSponsorInPost,
	title,
	author,
	description,
	pubDate,
	coverImage,
	coverImageSelector,
	url: pageUrl,
	siteTitle,
	avatar,
	avatarSelector,
} = Astro.props;
---

{
	(showSharePoster || showSponsorInPost) && (
		<div class="mb-6 rounded-xl onload-animation">
			<div class="p-6 bg-(--license-block-bg) rounded-xl">
				<div class="flex flex-col sm:flex-row items-center justify-between gap-4">
					<div class="flex items-center gap-3 flex-1">
						<div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
							<Icon
								name={
									showSponsorInPost
										? "material-symbols:favorite"
										: "material-symbols:share"
								}
								class="text-2xl"
							/>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
								{showSponsorInPost ? i18n(I18nKey.sponsorButton) : i18n(I18nKey.shareOnSocial)}
							</h3>
							<p class="text-sm text-neutral-600 dark:text-neutral-400">
								{showSponsorInPost ? i18n(I18nKey.sponsorButtonText) : i18n(I18nKey.shareOnSocialDescription)}
							</p>
						</div>
					</div>
					<div class="flex items-center gap-3">
						{
							showSharePoster && (
								<SharePoster
									client:load
									title={title}
									author={author}
									description={description}
									pubDate={pubDate}
									coverImage={coverImage}
									coverImageSelector={coverImageSelector}
									url={pageUrl}
									siteTitle={siteTitle}
									avatar={avatar}
									avatarSelector={avatarSelector}
								/>
							)
						}
						{
							showSponsorInPost && (
								<a
									href={url("/sponsor/")}
									class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap"
								>
									<span>{i18n(I18nKey.sponsor)}</span>
									<Icon name="fa7-solid:arrow-right" class="text-sm" />
								</a>
							)
						}
					</div>
				</div>
			</div>
		</div>
	)
}
