---
import { verifySignupToken } from "@server/auth/register";
import {
	buildUserSessionCookie,
	createSessionToken,
	getAuthUser,
} from "@server/auth/userSession";
import { cfEnv } from "../lib/api";

// 验证链接落地页：GET /verify/?token=xxx → 比对 hash → 置 verified=1 → 签发会话 → 落地个人资料页。
// 刻意不套 MainGridLayout：邮件点击进来的页面只要结果，不需要壁纸/侧栏/动态流，
// 否则首字节与首屏会被整站资源拖到数秒（实测 TTFB 1.8–3.7s）。
const title = "邮箱验证";
const token = Astro.url.searchParams.get("token") ?? "";
const alreadyLoggedIn = Boolean(await getAuthUser(Astro.request, cfEnv));

type State = "notoken" | "invalid" | "expired" | "banned" | "already";
let state: State = "notoken";

if (token) {
	const result = await verifySignupToken(cfEnv.DB, token);
	if (result.ok) {
		const row = await cfEnv.DB.prepare(
			"SELECT role, banned FROM users WHERE id = ?",
		)
			.bind(result.userId)
			.first<{ role: string; banned: number }>();

		if (row && row.banned !== 1) {
			const sessionToken = await createSessionToken(
				result.userId,
				row.role || "user",
				cfEnv,
			);
			const secure = Astro.url.protocol === "https:";
			const res = Astro.redirect("/profile/?verified=1");
			res.headers.append(
				"Set-Cookie",
				buildUserSessionCookie(sessionToken, secure, true),
			);
			return res;
		}
		state = "banned";
	} else {
		state =
			result.reason === "expired"
				? "expired"
				: result.reason === "already"
					? "already"
					: "invalid";
	}
}

const messages: Record<State, { heading: string; body: string }> = {
	notoken: {
		heading: "链接不完整",
		body: "验证链接缺少 token，请从邮件中重新点击链接，或重新发送验证邮件。",
	},
	invalid: {
		heading: "链接无效",
		body: "该验证链接无效。可以在注册页重新发送一封验证邮件。",
	},
	already: {
		heading: "邮箱已完成验证",
		body: "这个邮箱已经验证过了，直接登录即可。如果是邮件客户端提前打开了链接，也会看到此提示。",
	},
	expired: {
		heading: "链接已过期",
		body: "验证链接已超过 24 小时有效期，请重新发送一封验证邮件。",
	},
	banned: {
		heading: "账号不可用",
		body: "该账号已被封禁，无法完成验证。如有疑问请联系站长。",
	},
};

const msg = messages[state];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="robots" content="noindex, nofollow" />
		<style>
			.verify-page {
				color-scheme: light dark;
				--page: #fafafa;
				--card: #ffffff;
				--text: #1c1917;
				--muted: #78716c;
				--line: #e7e5e4;
			}
			@media (prefers-color-scheme: dark) {
				.verify-page {
					--page: #0c0a09;
					--card: #171514;
					--text: #f5f5f4;
					--muted: #a8a29e;
					--line: #292524;
				}
			}
			* { box-sizing: border-box; }
			/* 只作用于本页包裹层：直接写 body 会污染全站（后台 .shell 被 flex 居中挤窄） */
			.verify-page {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 24px 16px;
				background: var(--page);
				color: var(--text);
				font-family: system-ui, -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
			}
			.card {
				width: 100%;
				max-width: 420px;
				background: var(--card);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 32px 28px;
				text-align: center;
			}
			h1 { font-size: 19px; margin: 0 0 10px; }
			p { font-size: 14px; line-height: 1.7; color: var(--muted); margin: 0 0 22px; }
			a {
				display: block;
				padding: 11px 18px;
				border-radius: 12px;
				font-size: 14px;
				font-weight: 600;
				text-decoration: none;
				margin-top: 10px;
			}
			a.primary { background: #f97316; color: #fff; }
			a.ghost { border: 1px solid var(--line); color: var(--text); }
		</style>
	</head>
	<body style="margin:0">
		<div class="verify-page">
		<main class="card">
			<h1>{msg.heading}</h1>
			<p>{msg.body}</p>
			<a class="primary" href={alreadyLoggedIn ? "/profile/" : "/login/"}>{alreadyLoggedIn ? "返回个人资料" : "去登录"}</a>
			<a class="ghost" href="/register/">重新注册 / 重发验证邮件</a>
		</main>
		</div>
	</body>
</html>
