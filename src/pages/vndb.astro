---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
import { Icon } from "astro-icon/components";
import VndbGrid from "@/components/pages/vndb/VndbGrid.svelte";
import { siteConfig } from "@/config";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

if (!getSiteConfig(Astro.locals).pages.vndb) {
	return Astro.redirect("/404/");
}

const vndbConfig = {
	userId:
		((settings as any)?.["vndb"]?.username ??
			((settings as any)?.["vndb"] ?? siteConfig.vndb)?.userId) ||
		"",
	apiUrl: ((settings as any)?.["vndb"] ?? siteConfig.vndb)?.apiUrl || "https://api.vndb.org/kana",
	vnBaseUrl: ((settings as any)?.["vndb"] ?? siteConfig.vndb)?.vnBaseUrl || "https://vndb.org/",
	apiToken: ((settings as any)?.["vndb"] ?? siteConfig.vndb)?.apiToken || "",
	pagination: {
		limit: 100,
		delay: 100,
		maxTotal: 1000,
	},
	// NSFW 处理："off" | "blur" | "hide"
	nsfw: (((settings as any)?.["vndb"] ?? siteConfig.vndb)?.nsfw ?? "blur") as "off" | "blur" | "hide",
};

// 检查是否已配置 VNDB 用户ID
const isUserIdConfigured =
	vndbConfig.userId.trim() !== "" && vndbConfig.userId !== "you-user-id";
---

<MainGridLayout title={i18n(I18nKey.vndb)} description={i18n(I18nKey.vndbSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
              <Icon name="material-symbols:chrome-reader-mode-rounded" class="text-[1.5rem]"></Icon>
            </div>
            <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {i18n(I18nKey.vndb)}
            </div>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {i18n(I18nKey.vndbSubtitle)}
          </p>
        </div>

        {!isUserIdConfigured ? (
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.vndbNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.vndbNotConfiguredDesc)}
            </p>
          </div>
        ) : (
            <VndbGrid
              client:load
              fetchConfig={{
                pagination: vndbConfig.pagination,
                nsfw: vndbConfig.nsfw
              }}
              vnBaseUrl={vndbConfig.vnBaseUrl}
            />
        )}
      </div>
    </div>
  </div>
</MainGridLayout>
