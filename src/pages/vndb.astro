---
import "@/styles/pages/common.css";
import { Icon } from "astro-icon/components";
import VndbGrid from "@/components/pages/vndb/VndbGrid.svelte";
import { siteConfig } from "@/config";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

if (!getSiteConfig(Astro.locals).pages.vndb) {
	return Astro.redirect("/404/");
}

// D1 vndb 组优先，静态 siteConfig.vndb 兜底
type VndbGroup = NonNullable<typeof siteConfig.vndb> & { username?: string };
const vndb: VndbGroup =
	(Astro.locals.settings as { vndb?: VndbGroup } | undefined)?.vndb ??
	siteConfig.vndb ??
	{};

const vndbConfig = {
	userId: (vndb.username ?? vndb.userId) || "",
	apiUrl: vndb.apiUrl || "https://api.vndb.org/kana",
	vnBaseUrl: vndb.vnBaseUrl || "https://vndb.org/",
	apiToken: vndb.apiToken || "",
	pagination: {
		limit: 100,
		delay: 100,
		maxTotal: 1000,
	},
	// NSFW 处理："off" | "blur" | "hide"
	nsfw: (vndb.nsfw ?? "blur") as "off" | "blur" | "hide",
};

// 检查是否已配置 VNDB 用户ID
const isUserIdConfigured =
	vndbConfig.userId.trim() !== "" && vndbConfig.userId !== "you-user-id";
---

<MainGridLayout title={i18n(I18nKey.vndb)} description={i18n(I18nKey.vndbSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="relative w-full mb-8">
        <div class="mb-6">
                    <div class="page-heading">
              <div class="page-icon" aria-hidden="true">
                  <Icon name="material-symbols:chrome-reader-mode-rounded" />
              </div>
              <div>
                  <h2>{i18n(I18nKey.vndb)}</h2>
                  <p>{i18n(I18nKey.vndbSubtitle)}</p>
              </div>
          </div>
        </div>

        {!isUserIdConfigured ? (
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.vndbNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.vndbNotConfiguredDesc)}
            </p>
          </div>
        ) : (
            <VndbGrid
              client:load
              fetchConfig={{
                pagination: vndbConfig.pagination,
                nsfw: vndbConfig.nsfw
              }}
              vnBaseUrl={vndbConfig.vnBaseUrl}
            />
        )}
      </div>
    </div>
  </div>
</MainGridLayout>
