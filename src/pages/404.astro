---
import { url } from "@shared/utils/url-utils";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 该页会被其它路由 rewrite 复用（同一响应对象），middleware 无法仅凭 status 判定是否为错误页，
// 故显式打标记，middleware 见标记即跳过边缘缓存写入与 CDN 缓存头
Astro.response.headers.set("x-firedre-no-store", "1");
---

<MainGridLayout title={i18n(I18nKey.notFound)} description={i18n(I18nKey.notFoundDescription)}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96">
        <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">

            <div class="text-8xl md:text-9xl font-bold text-(--primary) opacity-20 mb-4">
                {i18n(I18nKey.notFound)}
            </div>

            <div class="mb-6">
                <Icon name="material-symbols:error-outline" class="text-6xl text-(--primary-text)" />
            </div>

            <div class="text-3xl md:text-4xl font-bold mb-4 text-90">
                {i18n(I18nKey.notFoundTitle)}
            </div>

            <p class="text-lg text-75 mb-8 max-w-md">
                {i18n(I18nKey.notFoundDescription)}
            </p>

            <a 
                href={url("/")}
                class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary-fill) text-(--primary-on-fill) rounded-(--radius-large) hover:bg-(--btn-content) transition-colors duration-200 font-medium"
            >
                <Icon name="material-symbols:home" class="text-xl" />
                {i18n(I18nKey.backToHome)}
            </a>

            <div class="absolute top-4 left-4 opacity-10">
                <Icon name="material-symbols:sentiment-sad" class="text-4xl text-(--primary-text)" />
            </div>
            <div class="absolute bottom-4 right-4 opacity-10">
                <Icon name="material-symbols:search-off" class="text-4xl text-(--primary-text)" />
            </div>
        </div>
    </div>
</MainGridLayout>

<style>

    .card-base {
        animation: fadeInUp 0.6s ease-out;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    a:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.3);
    }
</style>