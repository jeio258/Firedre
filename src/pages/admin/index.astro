---
export const prerender = false;

import AdminApp from "../../components/admin/AdminApp.svelte";

import "@/styles/variables.styl";

const settings = (Astro.locals as { settings?: { hue?: number; themeColor?: { hue?: number } } })
	?.settings ?? {};
const configHue = settings.hue ?? settings.themeColor?.hue ?? 165;
const defaultMode =
	((settings as unknown as Record<string, unknown>)?.defaultMode as string) ??
	"light";
---
<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="utf-8" />
	<script is:inline define:vars={{ configHue, defaultMode }}>
		// 主题初始化：复用前端深浅模式（localStorage["theme"] / 系统偏好）
		(function () {
			try {
				const theme = localStorage.getItem("theme") || defaultMode;
				const isDark =
					theme === "dark" ||
					(theme === "system" &&
						window.matchMedia("(prefers-color-scheme: dark)").matches);
				document.documentElement.classList.toggle("dark", isDark);
				const hue = localStorage.getItem("hue") || configHue;
				document.documentElement.style.setProperty("--hue", hue);
			} catch (e) {}
		})();
	</script>
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>登录 - Firedre 后台</title>

	<link rel="icon" href="/favicon/favicon.ico" />
	<link rel="icon" href="/favicon/favicon-dark-32.png" sizes="32x32" media="(prefers-color-scheme: dark)" />
	<style define:vars={{ configHue }}>

		html{--hue:var(--configHue)}
		html,body{margin:0;padding:0;background:var(--page-bg);font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;color:var(--deep-text);-webkit-text-size-adjust:100%}
		*{box-sizing:border-box}
	</style>
</head>
<body style="margin:0;background:var(--page-bg);font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif">
	<AdminApp client:load />
</body>
</html>
