---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
import { Icon } from "astro-icon/components";
import BilibiliGrid from "@/components/pages/bilibili/BilibiliGrid.svelte";
import { siteConfig } from "@/config";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

// 检查页面是否启用
if (!getSiteConfig(Astro.locals).pages.bilibili) {
	return Astro.redirect("/404/");
}

// 获取构建时间
const buildTime = formatDateI18nWithTime(new Date());

// Bilibili 配置
const BILIBILI_UID = ((settings as any)?.["bilibili"] ?? siteConfig.bilibili)?.uid;
const isConfigured = !!BILIBILI_UID && BILIBILI_UID.trim() !== "";
---

<MainGridLayout
	title={((settings as any)?.["bilibili"]?.title as string | undefined) || i18n(I18nKey.bilibili)}
	description={i18n(I18nKey.bilibiliSubtitle)}
>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">

      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
              <Icon name="fa7-brands:bilibili" class="text-[1.5rem]"></Icon>
            </div>
            <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {i18n(I18nKey.bilibili)}
            </div>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {i18n(I18nKey.bilibiliSubtitle)}
          </p>
          <p class="text-xs text-neutral-500 dark:text-neutral-500 mt-2">
            {i18n(I18nKey.animeLastUpdated)} {buildTime}
          </p>
        </div>

        {!isConfigured ? (

          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.bilibiliNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.bilibiliNotConfiguredDesc)}
            </p>
          </div>
        ) : (
          <>

            <BilibiliGrid client:load dynamic />
          </>
        )}
      </div>
    </div>
  </div>
</MainGridLayout>