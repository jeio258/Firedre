---
import "@/styles/pages/common.css";
import { getSiteConfig } from "@shared/config/runtime";
import { Icon } from "astro-icon/components";
import BilibiliGrid from "@/components/pages/bilibili/BilibiliGrid.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

if (!getSiteConfig(Astro.locals).pages.bilibili) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(
	new Date(),
	getSiteConfig(Astro.locals),
);

// D1 bilibili 组优先，静态 siteConfig.bilibili 兜底
type BiliGroup = NonNullable<typeof siteConfig.bilibili> & {
	title?: string;
	enabled?: boolean;
};
const bilibili: BiliGroup =
	(Astro.locals.settings as { bilibili?: BiliGroup } | undefined)?.bilibili ??
	siteConfig.bilibili ??
	{};
// Bilibili 配置（数据由 BilibiliGrid 客户端经 /api/bilibili 代理拉取，SSR 不阻塞第三方）
const BILIBILI_UID = bilibili.uid;
const isConfigured = !!BILIBILI_UID && BILIBILI_UID.trim() !== "";
---

<MainGridLayout
	title={bilibili.title || i18n(I18nKey.bilibili)}
	description={i18n(I18nKey.bilibiliSubtitle)}
>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">

      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="page-heading">
            <div class="page-icon" aria-hidden="true">
              <Icon name="fa7-brands:bilibili" />
            </div>
            <div>
              <h2>{i18n(I18nKey.bilibili)}</h2>
              <p>{i18n(I18nKey.bilibiliSubtitle)}</p>
            </div>
            <p class="page-updated">
              <span>{i18n(I18nKey.animeLastUpdated)} {buildTime}</span>
            </p>
          </div>
        </div>

        {!isConfigured ? (
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.bilibiliNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.bilibiliNotConfiguredDesc)}
            </p>
          </div>
        ) : (
          <BilibiliGrid client:load uid={BILIBILI_UID} />
        )}
      </div>
    </div>
  </div>
</MainGridLayout>