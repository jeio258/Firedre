---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
import { Icon } from "astro-icon/components";
import BangumiGrid from "@/components/pages/bangumi/BangumiGrid.svelte";
import { siteConfig } from "@/config";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

if (!getSiteConfig(Astro.locals).pages.bangumi) {
	return Astro.redirect("/404/");
}

const bangumiConfig = {
	username:
		((settings as any)?.["bangumi"]?.username ??
			((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.userId) ||
		"",
	apiUrl: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.apiUrl || "https://api.bangumi.one",
	subjectBaseUrl:
		((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.subjectBaseUrl || "https://bangumi.one/subject/",
	// 从配置文件中读取各分类是否启用，若未配置则使用默认值
	categories: {
		book: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.categories?.book ?? true,
		anime: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.categories?.anime ?? true,
		music: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.categories?.music ?? true,
		game: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.categories?.game ?? true,
		real: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.categories?.real ?? false,
	},
	pagination: {
		limit: 50,
		delay: 50,
		maxTotal: 1000,
	},
	// NSFW 处理："off" | "blur" | "hide"
	nsfw: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.nsfw ?? "off",
};

// 检查是否已配置 Bangumi 用户ID
const isUserIdConfigured =
	bangumiConfig.username &&
	bangumiConfig.username !== "you-user-id" &&
	bangumiConfig.username.trim() !== "";
---

<MainGridLayout title={i18n(I18nKey.bangumi)} description={i18n(I18nKey.bangumiSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">

        <div class="relative w-full mb-8">
            <div class="mb-6">
                <div class="flex items-center gap-3 mb-3">
                    <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
                        <Icon name="material-symbols:movie" class="text-[1.5rem]"></Icon>
                    </div>
                    <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
                        {i18n(I18nKey.bangumi)}
                    </div>
                </div>
                <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    {i18n(I18nKey.bangumiSubtitle)}
                </p>
            </div>
        </div>

        {!isUserIdConfigured ? (
            <div class="text-center py-16">
              <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
                <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
              </div>
              <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
                未配置 Bangumi 用户ID
              </h2>
              <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
                请在后台设置中配置你的 Bangumi 用户ID
              </p>
            </div>
          ) : (
            <BangumiGrid
              client:load
              subjectBaseUrl={bangumiConfig.subjectBaseUrl}
              fetchConfig={{
                username: bangumiConfig.username!,
                apiUrl: bangumiConfig.apiUrl,
                categories: bangumiConfig.categories,
                categoryOrder: ((settings as any)?.["bangumi"] ?? siteConfig.bangumi)?.categoryOrder || [],
                pagination: bangumiConfig.pagination,
                nsfw: bangumiConfig.nsfw,
              }}
            />
          )}
		</div>
  </div>
</MainGridLayout>

<style>

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
