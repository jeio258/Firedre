---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};
import { Icon } from "astro-icon/components";
import DynamicFeed from "@/components/pages/dynamic/DynamicFeed.svelte";
import DynamicItemTemplate from "@/components/pages/dynamic/DynamicItemTemplate.astro";
import { commentConfig, dynamicConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/dynamic.css";
import { url } from "@/utils/url-utils";

// 运行时站点配置（后台可编辑；静态 config 为兜底）



if (!((settings as any)?.["pages"] ?? siteConfig.pages).dynamic) {
	return Astro.redirect("/404/");
}

const title = ((((settings as any)?.["dynamic"]) as any)?.["title"] ?? dynamicConfig.title) || i18n(I18nKey.dynamic);
const description =
	((((settings as any)?.["dynamic"]) as any)?.["description"] ?? dynamicConfig.description) || i18n(I18nKey.dynamicDescription);
const itemsPerPage = Math.max(1, ((((settings as any)?.["dynamic"]) as any)?.["itemsPerPage"] ?? dynamicConfig.itemsPerPage) ?? 10);
const showInlineComments = Boolean(
	((((settings as any)?.["dynamic"]) as any)?.["showComment"] ?? dynamicConfig.showComment) !== false &&
		((((settings as any)?.["comment"]) as any)?.["type"] ?? commentConfig.type) &&
		((((settings as any)?.["comment"]) as any)?.["type"] ?? commentConfig.type) !== "none",
);
const dataUrl = ((((settings as any)?.["dynamic"]) as any)?.["apiUrl"] ?? dynamicConfig.apiUrl)?.startsWith("http")
	? ((((settings as any)?.["dynamic"]) as any)?.["apiUrl"] ?? dynamicConfig.apiUrl)
	: url(((((settings as any)?.["dynamic"]) as any)?.["apiUrl"] ?? dynamicConfig.apiUrl) || "/api/dynamic.json");
const memos = ((((settings as any)?.["dynamic"]) as any)?.["memos"] ?? dynamicConfig.memos);
---

<MainGridLayout title={title} description={description}>
	<section class="dynamic-page" aria-labelledby="dynamic-page-title">
		<div>
			<header class="dynamic-page-header card-base">
				<div class="dynamic-page-heading">
					<div class="dynamic-page-icon" aria-hidden="true">
						<Icon name="material-symbols:forum-rounded" />
					</div>
					<div>
						<h2 id="dynamic-page-title">{title}</h2>
						{description && <p>{description}</p>}
					</div>
				</div>
				<div
					class="dynamic-count"
					aria-label={i18n(I18nKey.dynamic)}
				>
					<Icon name="material-symbols:dynamic-feed-rounded" />
					<strong data-dynamic-page-count>0</strong>
					<span>{i18n(I18nKey.dynamic)}</span>
				</div>
				<div class="dynamic-filter">
					<label class="dynamic-search">
						<Icon name="material-symbols:search-rounded" />
						<input
							type="search"
							data-dynamic-search
							placeholder={i18n(I18nKey.dynamicSearch)}
						/>
					</label>
					<label class="dynamic-year-select">
						<Icon name="material-symbols:calendar-month-rounded" />
						<select data-year-select aria-label={i18n(I18nKey.year)}>
							<option value="all">{i18n(I18nKey.dynamicAllYears)}</option>
						</select>
						<Icon name="material-symbols:arrow-drop-down-rounded" />
					</label>
				</div>
			</header>

			<DynamicFeed
				client:load
				source={dataUrl}
				{itemsPerPage}
				showComments={showInlineComments}
				emptyText={i18n(I18nKey.dynamicEmpty)}
				noResultsText={i18n(I18nKey.dynamicNoResults)}
				loadingText={i18n(I18nKey.dynamicLoading)}
				allYearsText={i18n(I18nKey.dynamicAllYears)}
				timezone={((settings as any)?.["timezone"] ?? siteConfig.timezone) || "UTC"}
				{memos}
			/>

			<DynamicItemTemplate />
		</div>
	</section>
</MainGridLayout>
