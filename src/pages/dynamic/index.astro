---
const settings =
	(Astro.locals as { settings?: Record<string, unknown> }).settings ?? {};

import "@/styles/pages/common.css";
import { Icon } from "astro-icon/components";
import DynamicFeed from "@/components/pages/dynamic/DynamicFeed.svelte";
import DynamicItemTemplate from "@/components/pages/dynamic/DynamicItemTemplate.astro";
import { commentConfig, dynamicConfig, siteConfig } from "@/config";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { CommentConfig } from "@/types/commentConfig";
import type { DynamicConfig } from "@/types/dynamicConfig";
import "@/styles/pages/dynamic.css";
import { url } from "@/utils/url-utils";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

if (!getSiteConfig(Astro.locals).pages.dynamic) {
	return Astro.redirect("/404/");
}

// 后台设置（动态主路径）→ 静态动态配置（极端兜底）；类型化读取，避免显式 any 断言
const dynamicSettings: DynamicConfig =
	(settings["dynamic"] as DynamicConfig | undefined) ?? {};
const commentSettings = (settings["comment"] ?? {}) as Partial<CommentConfig>;

const title =
	dynamicSettings.title ?? dynamicConfig.title ?? i18n(I18nKey.dynamic);
const description = dynamicSettings.description ?? dynamicConfig.description;
const itemsPerPage =
	dynamicSettings.itemsPerPage ?? dynamicConfig.itemsPerPage ?? 10;
const showInlineComments = Boolean(
	(dynamicSettings.showComment ?? dynamicConfig.showComment) !== false &&
		(commentSettings.type ?? commentConfig.type) &&
		(commentSettings.type ?? commentConfig.type) !== "none",
);
const apiUrlSetting = dynamicSettings.apiUrl ?? dynamicConfig.apiUrl;
const dataUrl = apiUrlSetting?.startsWith("http")
	? apiUrlSetting
	: url(apiUrlSetting || "/api/dynamic.json");
const memos = dynamicSettings.memos ?? dynamicConfig.memos;
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell" aria-labelledby="dynamic-page-title">
		<div>
			<header class="page-header card-base">
				<div class="page-heading">
					<div class="page-icon" aria-hidden="true">
						<Icon name="material-symbols:forum-rounded" />
					</div>
					<div>
						<h2 id="dynamic-page-title">{title}</h2>
						{description && <p>{description}</p>}
					</div>
				</div>
				<div
					class="page-count"
					aria-label={i18n(I18nKey.dynamic)}
				>
					<Icon name="material-symbols:dynamic-feed-rounded" />
					<strong data-dynamic-page-count>0</strong>
					<span>{i18n(I18nKey.dynamic)}</span>
				</div>
				<div class="page-filter">
					<label class="page-search">
						<Icon name="material-symbols:search-rounded" />
						<input
							type="search"
							data-dynamic-search
							placeholder={i18n(I18nKey.dynamicSearch)}
						/>
					</label>
					<label class="page-year-select">
						<Icon name="material-symbols:calendar-month-rounded" />
						<select data-year-select aria-label={i18n(I18nKey.year)}>
							<option value="all">{i18n(I18nKey.dynamicAllYears)}</option>
						</select>
						<Icon name="material-symbols:arrow-drop-down-rounded" />
					</label>
				</div>
			</header>

			<DynamicFeed
				client:load
				source={dataUrl}
				{itemsPerPage}
				showComments={showInlineComments}
				emptyText={i18n(I18nKey.dynamicEmpty)}
				noResultsText={i18n(I18nKey.dynamicNoResults)}
				loadingText={i18n(I18nKey.dynamicLoading)}
				allYearsText={i18n(I18nKey.dynamicAllYears)}
				timezone={(settings["timezone"] as string) ?? siteConfig.timezone ?? "UTC"}
				{memos}
			/>

			<DynamicItemTemplate />
		</div>
	</section>
</MainGridLayout>