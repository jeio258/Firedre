---
import { Icon } from "astro-icon/components";
import EncryptedContent from "@/components/features/EncryptedContent.astro";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import { getSiteConfig } from "@/config/runtime";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { cfEnv } from "@/lib/api";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";
import { getGalleryAlbum } from "../../../server/gallery/service";
import { getAlbumPassword } from "../../../server/gallery/password";

// 运行时站点配置（后台可编辑；静态 config 为兜底）



export const prerender = false;

// 检查页面是否启用
if (!getSiteConfig(Astro.locals).pages.gallery) {
	return Astro.redirect("/404/");
}

const { album: albumId } = Astro.params;
if (!albumId) {
	return Astro.redirect("/404/");
}
const albumDetail = await getGalleryAlbum(cfEnv, albumId);

if (!albumDetail) {
	return Astro.redirect("/404/");
}

// 相册访问密码存 D1（动态博客方式），frontmatter 只保留 encrypted 标记
const albumPassword = await getAlbumPassword(cfEnv, albumId);

// Firedre：相册来自 R2（后台可编辑），frontmatter 驱动
const fm = albumDetail.frontmatter as Record<string, unknown>;
const albumMeta = {
	id: albumId,
	name: String(fm.title || albumId),
	description: fm.desc ? String(fm.desc) : undefined,
	date: fm.date ? String(fm.date) : undefined,
	location: fm.location ? String(fm.location) : undefined,
	tags: Array.isArray(fm.tags) ? fm.tags.map(String) : [],
	cover: fm.cover ? String(fm.cover) : undefined,
	// 判锁以 D1 密码存在与否为准（对齐 unlockGalleryAlbum / gallery-files / 公开 API），
	// 避免 R2 frontmatter.encrypted 与 D1 不同步时页面显示未锁定而实际已上锁。
	encrypted: !!albumPassword,
	password: albumPassword,
	passwordHint: fm.passwordHint ? String(fm.passwordHint) : "",
};

const photos: Array<{ url: string; type?: string; poster?: string; date?: string }> =
	Array.isArray(fm.photos)
		? (fm.photos as Array<unknown>)
				.filter(
					(p) =>
						p &&
						(typeof p === "string" ||
							(typeof p === "object" && (p as { url?: unknown }).url)),
				)
				.map((p) => {
					if (typeof p === "string") return { url: p };
					const obj = p as Record<string, unknown>;
					return {
						url: String(obj.url),
						type: obj.type ? String(obj.type) : undefined,
						poster: obj.poster ? String(obj.poster) : undefined,
						date: obj.date ? String(obj.date) : undefined,
					};
				})
		: [];
const cover = albumMeta.cover || "";
const columnWidth = 240;

// 加密相册的 cover 通常指向 /api/gallery-files/（需 accessPassword），
// 而封面横幅在解锁控件之外、无法带口令加载 → 会 401 显示破图。
// 加密时隐藏封面图，仅保留占位色块，避免泄漏相册内容缩略图。
const coverLoaded = cover && (!albumMeta.encrypted || !cover.includes("/api/gallery-files/"));
const coverUrl = coverLoaded ? cover : "";
const coverLqipProps = coverUrl
	? getLqipProps(coverUrl, undefined, true)
	: { style: "" };
---

<MainGridLayout title={albumMeta.name} description={albumMeta.description || ""}>
  <!-- 相册封面横幅 -->
  <div class="w-full rounded-(--radius-large) overflow-hidden relative">
    {coverUrl ? (
      <div class="relative w-full aspect-[3/1] min-h-[200px] max-h-[360px] overflow-hidden">
        <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={coverLqipProps.style} aria-hidden="true"></div>
        <img
          src={cover}
          alt={albumMeta.name}
          class="w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out"
        />
        <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent" />
        <!-- 返回按钮 -->
        <a
          href={url("/gallery/")}
          class="absolute top-4 left-4 inline-flex items-center gap-1.5 text-sm text-white/90 hover:text-white bg-black/30 hover:bg-black/50 backdrop-blur-sm px-3 py-1.5 rounded-lg transition-colors"
        >
          <Icon name="material-symbols:arrow-back" class="text-base" />
          {i18n(I18nKey.galleryBackToAlbums)}
        </a>
        <!-- 封面上的信息 -->
        <div class="absolute bottom-0 left-0 right-0 p-6">
          <div class="text-2xl sm:text-3xl font-bold text-white mb-2 drop-shadow-lg">
            {albumMeta.name}
          </div>
          {albumMeta.description && (
            <p class="text-sm text-white/75 leading-relaxed mb-2 max-w-2xl line-clamp-2">
              {albumMeta.description}
            </p>
          )}
          <div class="flex items-center gap-4 text-sm text-white/80 flex-wrap">
            {albumMeta.date && (
              <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:calendar-today" class="text-sm" />
                {albumMeta.date}
              </span>
            )}
            {albumMeta.location && (
              <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:location-on" class="text-sm" />
                {albumMeta.location}
              </span>
            )}
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:photo-library" class="text-sm" />
              {photos.length} {i18n(I18nKey.galleryPhotos)}
            </span>
          </div>
          {albumMeta.tags && albumMeta.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-2.5">
              {albumMeta.tags.map((tag) => (
                <span class="text-xs px-2 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="card-base px-6 py-4">
        <a
          href={url("/gallery/")}
          class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mb-3"
        >
          <Icon name="material-symbols:arrow-back" class="text-base" />
          {i18n(I18nKey.galleryBackToAlbums)}
        </a>
        <div class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
          {albumMeta.name}
        </div>
        <div class="flex items-center gap-4 text-sm text-neutral-500 dark:text-neutral-400 mt-2 flex-wrap">
          {albumMeta.date && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:calendar-today" class="text-sm" />
              {albumMeta.date}
            </span>
          )}
          {albumMeta.location && (
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:location-on" class="text-sm" />
              {albumMeta.location}
            </span>
          )}
          <span>{photos.length} {i18n(I18nKey.galleryPhotos)}</span>
        </div>
      </div>
    )}
  </div>

  <!-- 瀑布流照片网格 -->
  <div class="w-full rounded-(--radius-large) overflow-hidden relative mt-4">
    <div class="card-base z-10 px-6 py-6 relative w-full">
      {photos.length > 0 ? (
        albumMeta.password ? (
          <EncryptedContent password={albumMeta.password} slug={albumMeta.id} hint={albumMeta.passwordHint}>
            <div
              class="gallery-masonry"
              style={`column-count: 2; column-gap: 0.75rem; --col-width: ${columnWidth}px;`}
            >
              {photos.map((photo) => (
                <PhotoCard src={photo.url} type={photo.type} poster={photo.poster} albumId={albumMeta.id} />
              ))}
            </div>
          </EncryptedContent>
        ) : (
          <div
            class="gallery-masonry"
            style={`column-count: 2; column-gap: 0.75rem; --col-width: ${columnWidth}px;`}
          >
            {photos.map((photo) => (
              <PhotoCard src={photo.url} type={photo.type} poster={photo.poster} albumId={albumMeta.id} />
            ))}
          </div>
        )
      ) : (
        <div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
          <Icon name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50" />
          <p class="text-lg">{i18n(I18nKey.galleryNoAlbums)}</p>
        </div>
      )}
    </div>
  </div>

</MainGridLayout>