---
import "@/styles/pages/common.css";
import { getSiteConfig } from "@shared/config/runtime";
import { Icon } from "astro-icon/components";
import MalGrid from "@/components/pages/mal/MalGrid.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";

// 运行时站点配置（后台可编辑；静态 config 为兜底）

if (!getSiteConfig(Astro.locals).pages.mal) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(
	new Date(),
	getSiteConfig(Astro.locals),
);

// D1 myanimelist（含旧 mal 键）组优先，静态 siteConfig.mal 兜底
type MalGroup = NonNullable<typeof siteConfig.mal> & {
	username?: string;
	enabled?: boolean;
};
const malGroup = Astro.locals.settings as
	| { myanimelist?: MalGroup; mal?: MalGroup }
	| undefined;
const malSettings: MalGroup =
	malGroup?.myanimelist ?? malGroup?.mal ?? siteConfig.mal ?? {};
const malConfig = {
	username: malSettings.username || "",
	clientId: malSettings.clientId || "",
	animeBaseUrl: malSettings.animeBaseUrl || "https://myanimelist.net/anime/",
	mangaBaseUrl: malSettings.mangaBaseUrl || "https://myanimelist.net/manga/",
	// NSFW 处理："off" | "blur" | "hide"
	nsfw: (malSettings.nsfw ?? "off") as "off" | "blur" | "hide",
};

// 检查是否已配置用户名和 Client ID
const isConfigured =
	malConfig.username.trim() !== "" && malConfig.clientId.trim() !== "";
---

<MainGridLayout title={i18n(I18nKey.mal)} description={i18n(I18nKey.malSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">

      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="page-heading">
            <div class="page-icon" aria-hidden="true">
              <Icon name="material-symbols:menu-book" />
            </div>
            <div>
              <h2>{i18n(I18nKey.mal)}</h2>
              <p>{i18n(I18nKey.malSubtitle)}</p>
            </div>
            <p class="page-updated">
              <span>{i18n(I18nKey.malLastUpdated)} {buildTime}</span>
            </p>
          </div>
        </div>

        {!isConfigured ? (
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.malNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.malNotConfiguredDesc)}
            </p>
          </div>
        ) : (
          <MalGrid
            client:load
            animeBaseUrl={malConfig.animeBaseUrl}
            mangaBaseUrl={malConfig.mangaBaseUrl}
            nsfw={malConfig.nsfw}
          />
        )}
      </div>
    </div>
  </div>
</MainGridLayout>