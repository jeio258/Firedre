#!/bin/bash
# 暂存的 TS/JS/Svelte/Astro 过 biome（排除 vendored 的 src/music-sources/）
# 注：2026-09-20 起 tests/ 已并入 main，原"防 tests/ 进 main"规则随策略变更移除
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|svelte|astro)$' | grep -v 'src/music-sources/' || true)
if [ -n "$FILES" ]; then
  npx biome check $FILES || exit 1
fi
