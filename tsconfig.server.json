{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "node",
      "astro/client"
    ],
    "noEmit": true,
    "checkJs": false
  },
  "include": [
    "server/**/*",
    "types/**/*",
    "utils/**/*",
    "shared/**/*",
    "src/config/**/*",
    "src/utils/fetch-dedup.ts"
  ]
}
